---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Hero from "@/components/Hero.astro";
import Pricing from "@/components/Pricing.astro";
import Support from "@/components/Support.astro";
import About from "@/components/About.astro";
import OurTeam from "@/components/OurTeam.astro";
import FAQ from "@/components/FAQ.astro";
import YouTubeBanner from "@/components/YouTubeBanner.astro";
import StudentReviews from "@/components/StudentReviews.astro";
import Footer from "@/components/Footer.astro";
---

<BaseLayout
  title="Mexo Mentorship Program"
  description="You're Still Unprofitable? It's Time To Become Profitable."
>
  <Header />
  <main id="main">
    <Hero />
    <Pricing />
    <Support />
    <About />
    <OurTeam />
    <YouTubeBanner />
    <StudentReviews />
    <FAQ />
  </main>
  <Footer />
</BaseLayout>
