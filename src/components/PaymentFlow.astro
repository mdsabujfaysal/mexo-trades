<script>
  // Frontend-only submission targets. There is no backend: the payment
  // screenshot + caption are sent directly from the browser to Telegram
  // (primary) and Discord (backup) in parallel. Submission counts as a
  // success as soon as either one accepts the message.
  //
  // NOTE: because this project has no server, these values are visible
  // to anyone who inspects the page source or network requests. That is
  // an inherent trade-off of a frontend-only architecture, not a bug.
  const TELEGRAM_BOT_TOKEN = "8966048043:AAFzEdXs0nwv_ycpeYECqKPgiBpi6P5xuok";
  const TELEGRAM_CHAT_ID = "8564033086";
  const TELEGRAM_API_URL = `https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendPhoto`;
  const DISCORD_WEBHOOK_URL =
    "https://discord.com/api/webhooks/1529924194408726629/2LuY0lMrZuuIUEg3qE90O9piPVn-9jmNE4G_0Bu7ACMO18ZPSImzhwa4oD6cGP-kcYEL";

  const STEP_TITLES: Record<number, string> = {
    1: "Mentorship Plan",
    2: "Your Information",
    3: "Payment Method",
    4: "Payment Confirmation",
    5: "Submit Payment",
    6: "Upload Payment Proof",
  };

  const PLANS = {
    premium: { label: "Premium", usd: 100, bdt: 12700 },
  };

  type MethodCategory = "mobile" | "binance" | "usdt";

  const METHODS: Record<
    string,
    {
      name: string;
      category: MethodCategory;
      number?: string;
      uid?: string;
      network?: string;
      address?: string;
    }
  > = {
    bkash: { name: "bKash", category: "mobile", number: "01622504941" },
    nagad: { name: "Nagad", category: "mobile", number: "01622504941" },
    rocket: { name: "Rocket", category: "mobile", number: "01622504941" },
    binance: { name: "Binance ID", category: "binance", uid: "836830072" },
    usdt_trc20: {
      name: "USDT (TRC20)",
      category: "usdt",
      network: "TRON (TRC20)",
      address: "TB6L5VAXuXZVc4gdajkg9DSfcPrG7om6xv",
    },
    usdt_bep20: {
      name: "USDT (BEP20)",
      category: "usdt",
      network: "BNB Smart Chain (BEP20)",
      address: "0xda4518c12cfbb6e6d498b1511161288a50f3a47d",
    },
  };

  const SENDER_LABELS: Record<MethodCategory, [string, string]> = {
    mobile: ["Sender Number", "Transaction ID"],
    binance: ["Binance Email or UID (Sender Account)", "Binance Transaction ID (TxID)"],
    usdt: ["Sender Wallet Address", "Transaction Hash (TxID)"],
  };

  let selectedPlan: "premium" = "premium";
  let selectedMethod: string | null = null;
  let currentStep = 1;
  let enrollmentData: Record<string, string> | null = null;
  let proofFile: File | null = null;

  const planCards = document.querySelectorAll<HTMLButtonElement>("[data-plan-option]");
  const methodCards = document.querySelectorAll<HTMLButtonElement>("[data-method]");
  const stepDivs = document.querySelectorAll<HTMLDivElement>("[data-step]");
  const progressFill = document.getElementById("progress-fill") as HTMLDivElement;
  const progressLabel = document.getElementById("progress-label") as HTMLSpanElement;
  const progressTitle = document.getElementById("progress-title") as HTMLSpanElement;

  function renderPlanSelection() {
    planCards.forEach((card) => {
      const isSelected = card.dataset.planOption === selectedPlan;
      card.classList.toggle("selected", isSelected);
      card.setAttribute("aria-pressed", String(isSelected));
    });
  }

  function goToStep(step: number) {
    currentStep = step;
    stepDivs.forEach((div) => {
      div.classList.toggle("hidden", div.dataset.step !== String(step));
    });
    progressFill.style.width = `${(step / 6) * 100}%`;
    progressLabel.textContent = `Step ${step} of 6`;
    progressTitle.textContent = STEP_TITLES[step];
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  document.querySelectorAll<HTMLButtonElement>("[data-back-to]").forEach((btn) => {
    btn.addEventListener("click", () => goToStep(Number(btn.dataset.backTo)));
  });

  planCards.forEach((card) => {
    card.addEventListener("click", () => {
      selectedPlan = card.dataset.planOption as "premium";
      renderPlanSelection();
    });
  });

  document.getElementById("to-step-2")?.addEventListener("click", () => goToStep(2));

  const confirmCorrect = document.getElementById("confirm-correct") as HTMLInputElement;
  const toStep3Btn = document.getElementById("to-step-3") as HTMLButtonElement;

  const fullNameInput = document.getElementById("fullName") as HTMLInputElement;
  const emailInput = document.getElementById("email") as HTMLInputElement;
  const phoneInput = document.getElementById("phone") as HTMLInputElement;
  const telegramInput = document.getElementById("telegram") as HTMLInputElement;
  const countryInput = document.getElementById("country") as HTMLInputElement;
  const tradingExperienceInput = document.getElementById("tradingExperience") as HTMLSelectElement;

  const isValidEmail = (value: string) => /^[^\s@]+@gmail\.com$/i.test(value.trim());
  const isValidPhone = (value: string) => /^\d{11}$/.test(value.trim());

  const infoFields = [
    { input: fullNameInput, errorId: "fullName-error", isValid: (v: string) => v.trim().length > 0 },
    { input: emailInput, errorId: "email-error", isValid: isValidEmail },
    { input: phoneInput, errorId: "phone-error", isValid: isValidPhone },
    { input: telegramInput, errorId: "telegram-error", isValid: (v: string) => v.trim().length > 0 },
    { input: countryInput, errorId: "country-error", isValid: (v: string) => v.trim().length > 0 },
    { input: tradingExperienceInput, errorId: "tradingExperience-error", isValid: (v: string) => v.trim().length > 0 },
  ];

  const setFieldError = (input: HTMLInputElement, errorId: string, hasError: boolean) => {
    const errorEl = document.getElementById(errorId);
    input.classList.toggle("border-red-500", hasError);
    input.classList.toggle("focus:border-red-500", hasError);
    input.classList.toggle("focus:ring-red-500", hasError);
    input.classList.toggle("border-slate-300", !hasError);
    input.classList.toggle("focus:border-blue-700", !hasError);
    input.classList.toggle("focus:ring-blue-700", !hasError);
    errorEl?.classList.toggle("hidden", !hasError);
  };

  const validateAllFields = (showErrors: boolean) => {
    let allValid = true;
    infoFields.forEach(({ input, errorId, isValid }) => {
      const valid = isValid(input.value);
      if (!valid) allValid = false;
      if (showErrors) setFieldError(input, errorId, !valid);
    });
    return allValid;
  };

  const setContinueEnabled = (enabled: boolean) => {
    toStep3Btn.disabled = !enabled;
    toStep3Btn.setAttribute("aria-disabled", String(!enabled));
    toStep3Btn.classList.toggle("opacity-30", !enabled);
    toStep3Btn.classList.toggle("pointer-events-none", !enabled);
  };

  infoFields.forEach(({ input, errorId }) => {
    const revalidate = () => {
      if (confirmCorrect.checked) {
        const allValid = validateAllFields(true);
        setContinueEnabled(allValid);
      } else {
        setFieldError(input, errorId, false);
      }
    };
    input.addEventListener("input", revalidate);
    input.addEventListener("change", revalidate);
  });

  confirmCorrect.addEventListener("change", () => {
    if (confirmCorrect.checked) {
      const allValid = validateAllFields(true);
      setContinueEnabled(allValid);
    } else {
      setContinueEnabled(false);
    }
  });

  toStep3Btn.addEventListener("click", () => {
    if (toStep3Btn.disabled) return;
    goToStep(3);
  });

  const toStep4Btn = document.getElementById("to-step-4") as HTMLButtonElement;

  methodCards.forEach((card) => {
    card.addEventListener("click", () => {
      selectedMethod = card.dataset.method ?? null;
      methodCards.forEach((c) => {
        const isSelected = c === card;
        c.classList.toggle("selected", isSelected);
        c.setAttribute("aria-pressed", String(isSelected));
      });
      toStep4Btn.disabled = false;
      toStep4Btn.classList.remove("disabled:opacity-40");
    });
  });

  const METHOD_BRANDING: Record<string, { bg: string; border: string }> = {
    bkash: { bg: "bg-red-50", border: "border-red-100" },
    nagad: { bg: "bg-orange-50", border: "border-orange-100" },
    rocket: { bg: "bg-purple-50", border: "border-purple-100" },
    binance: { bg: "bg-yellow-50", border: "border-yellow-100" },
    usdt_trc20: { bg: "bg-green-50", border: "border-green-100" },
    usdt_bep20: { bg: "bg-lime-50", border: "border-lime-100" },
  };
  const ALL_BRANDING_CLASSES = Array.from(
    new Set(Object.values(METHOD_BRANDING).flatMap((b) => [b.bg, b.border]))
  );

  toStep4Btn.addEventListener("click", () => {
    if (!selectedMethod) return;
    const method = METHODS[selectedMethod];
    const plan = PLANS[selectedPlan];

    (document.getElementById("confirm-plan") as HTMLSpanElement).textContent = plan.label;
    const crownEl = document.getElementById("confirm-plan-crown") as HTMLSpanElement;
    crownEl.classList.remove("hidden");
    crownEl.classList.add("flex");
    (document.getElementById("confirm-method") as HTMLSpanElement).textContent = method.name;

    const amountEl = document.getElementById("confirm-amount") as HTMLSpanElement;
    if (method.category === "mobile") {
      amountEl.innerHTML = `৳${plan.bdt.toLocaleString()} <span class="text-sm font-semibold align-baseline">BDT</span>`;
    } else {
      amountEl.innerHTML = `$${plan.usd} <span class="text-sm font-semibold align-baseline">USD</span>`;
    }

    const confirmationCard = document.getElementById("confirmation-card") as HTMLDivElement;
