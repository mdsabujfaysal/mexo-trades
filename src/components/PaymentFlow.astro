  function startPaymentTimer() {
    if (paymentTimerInterval) clearInterval(paymentTimerInterval);
    let remaining = PAYMENT_TIMER_SECONDS;
    paymentTimerSection.classList.remove("timer-done");
    paymentTimerLabel.textContent = "Waiting For Payment...";
    paymentTimerEl.textContent = formatTimer(remaining);
    paymentDoneBtn.textContent = "Payment Sent";
    paymentDoneBtn.classList.remove("payment-sent-locked");
    setPaymentDoneEnabled(false);

    paymentTimerInterval = window.setInterval(() => {
      remaining -= 1;
      if (remaining <= 0) {
        clearInterval(paymentTimerInterval);
        paymentTimerEl.textContent = "00:00";
        paymentTimerLabel.textContent = "You Can Confirm Now";
        paymentTimerSection.classList.add("timer-done");
        setPaymentDoneEnabled(true);
        return;
      }
      paymentTimerEl.textContent = formatTimer(remaining);
    }, 1000);
  }

  function renderDestinationFields() {
