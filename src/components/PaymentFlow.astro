---
---

<section class="relative overflow-hidden bg-slate-50 py-12">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 mx-auto h-72 w-72 rounded-full bg-gradient-to-br from-blue-300/30 to-emerald-300/30 blur-3xl"
  >
  </div>

  <div class="mx-auto max-w-2xl px-6">
    <h1 class="sr-only">MEXO TRADES Mentorship Enrollment</h1>

    <!-- Progress indicator -->
    <div class="mb-10">
      <div class="flex items-center justify-between">
        <span id="progress-label" class="text-xs font-bold uppercase tracking-[0.15em] text-slate-400">
          Step 1 of 6
        </span>
        <span id="progress-title" class="text-sm font-bold text-slate-900">Mentorship Plan</span>
      </div>
      <div class="mt-3 h-1.5 w-full overflow-hidden rounded-full bg-slate-200">
        <div
          id="progress-fill"
          class="h-full rounded-full bg-gradient-to-r from-blue-600 to-emerald-500 transition-all duration-500 ease-out"
          style="width: 16.666%"
        >
        </div>
      </div>
    </div>

    <!-- STEP 1: Mentorship Plan -->
    <div data-step="1" class="page-card rounded-[2rem] border border-white/60 bg-white/70 p-6 shadow-[0_20px_60px_-20px_rgba(15,23,42,0.2)] backdrop-blur-xl sm:p-10">
      <a
        href="/"
        class="back-btn mb-6 inline-flex items-center gap-1.5 text-sm font-semibold text-slate-500 transition-colors hover:text-slate-900"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Back
      </a>

      <h2 class="text-center text-2xl font-extrabold tracking-tight text-slate-900">Choose Your Mentorship</h2>
      <p class="mt-2 text-center text-sm text-slate-500">Select the plan that fits your trading goals.</p>

      <div class="mx-auto mt-8 flex max-w-sm justify-center">
        <button
          type="button"
          data-plan-option="premium"
          aria-pressed="false"
          class="plan-card group relative rounded-[1.75rem] bg-gradient-to-br from-blue-500 via-cyan-400 to-emerald-500 p-px text-left shadow-[0_15px_40px_-15px_rgba(16,185,129,0.4)] transition-all duration-300 ease-out hover:-translate-y-1 hover:shadow-[0_25px_55px_-15px_rgba(16,185,129,0.5)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700"
        >
          <div class="plan-card-inner relative overflow-hidden rounded-[calc(1.75rem-1px)] bg-gradient-to-br from-blue-200 via-cyan-100 to-emerald-200 transition-all duration-300">
            <div class="relative overflow-hidden px-6 pb-6 pt-7">
              <div
                aria-hidden="true"
                class="pointer-events-none absolute -right-10 -top-10 h-36 w-36 rounded-full bg-white/40 blur-2xl"
              >
              </div>

              <span class="absolute right-4 top-4 z-10 inline-flex items-center gap-1 rounded-full bg-gradient-to-r from-blue-600 to-emerald-500 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-white shadow-[0_4px_15px_-3px_rgba(16,185,129,0.55)]">
                <svg class="h-2.5 w-2.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path d="M10 1.5 12.4 7l6 .5-4.6 4 1.4 5.9L10 14.5l-5.2 2.9 1.4-5.9-4.6-4 6-.5Z" />
                </svg>
                PRO
              </span>

              <div class="relative flex items-center gap-2.5">
                <span class="flex h-8 w-8 flex-none items-center justify-center rounded-full bg-gradient-to-br from-blue-600 to-emerald-500 text-white shadow-sm">
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4 8 3 2 5-6 5 6 3-2-2 10H6L4 8Z" />
                  </svg>
                </span>
                <span class="bg-gradient-to-r from-blue-600 to-emerald-600 bg-clip-text text-sm font-bold uppercase tracking-wide text-transparent">
                  Premium
                </span>
              </div>

              <div class="relative mt-6 flex items-baseline gap-1.5">
                <span class="text-4xl font-extrabold tracking-tight text-slate-900">$100</span>
                <span class="text-sm font-medium text-slate-500">/ 1 Month</span>
              </div>
            </div>

            <div class="relative px-6 pb-7 pt-5">
              <div class="h-px w-full bg-gradient-to-r from-blue-300/50 via-emerald-300/50 to-transparent"></div>
              <p class="mt-5 text-sm leading-relaxed text-slate-600">Unlock Core Trading Concepts</p>
            </div>
          </div>
        </button>
      </div>

      <button
        type="button"
        id="to-step-2"
        class="mt-10 w-full rounded-full bg-gradient-to-r from-blue-600 to-emerald-500 px-6 py-3.5 text-sm font-bold text-white shadow-[0_12px_25px_-8px_rgba(29,78,216,0.5)] transition-transform hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700"
      >
        Continue
      </button>
    </div>

    <!-- STEP 2: Your Information -->
    <div data-step="2" class="page-card hidden rounded-[2rem] border border-white/60 bg-white/70 p-6 shadow-[0_20px_60px_-20px_rgba(15,23,42,0.2)] backdrop-blur-xl sm:p-10">
      <button
        type="button"
        class="back-btn mb-6 inline-flex items-center gap-1.5 text-sm font-semibold text-slate-500 transition-colors hover:text-slate-900"
        data-back-to="1"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Back
      </button>

      <h2 class="text-center text-2xl font-extrabold tracking-tight text-slate-900">Your Information</h2>
      <p class="mt-2 text-center text-sm text-slate-500">Tell us where to reach you.</p>

      <form id="info-form" class="mt-8 space-y-5">
        <div>
          <label class="block text-sm font-semibold text-slate-700" for="fullName">Full Name</label>
          <input
            id="fullName"
            name="fullName"
            type="text"
            required
            class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white/80 px-4 py-2.5 text-sm text-slate-900 transition-colors focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700"
          />
          <p id="fullName-error" class="mt-1 hidden text-xs font-medium text-red-600">Please enter your full name.</p>
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700" for="email">Email Address</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white/80 px-4 py-2.5 text-sm text-slate-900 transition-colors focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700"
          />
          <p id="email-error" class="mt-1 hidden text-xs font-medium text-red-600">Please enter a valid email ending in @gmail.com (e.g. name@gmail.com).</p>
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700" for="phone">Phone Number</label>
          <input
            id="phone"
            name="phone"
            type="tel"
            required
            class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white/80 px-4 py-2.5 text-sm text-slate-900 transition-colors focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700"
          />
          <p id="phone-error" class="mt-1 hidden text-xs font-medium text-red-600">Phone number must be exactly 11 digits.</p>
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700" for="telegram">Telegram Username</label>
          <input
            id="telegram"
            name="telegram"
            type="text"
            placeholder="@username"
            required
            class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white/80 px-4 py-2.5 text-sm text-slate-900 transition-colors focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700"
          />
          <p id="telegram-error" class="mt-1 hidden text-xs font-medium text-red-600">Please enter your Telegram username.</p>
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700" for="country">Country</label>
          <input
            id="country"
            name="country"
            type="text"
            required
            class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white/80 px-4 py-2.5 text-sm text-slate-900 transition-colors focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700"
          />
          <p id="country-error" class="mt-1 hidden text-xs font-medium text-red-600">Please enter your country.</p>
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700" for="tradingExperience">Trading Experience</label>
          <select
            id="tradingExperience"
            name="tradingExperience"
            required
            class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white/80 px-4 py-2.5 text-sm text-slate-900 transition-colors focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700"
          >
            <option value="" disabled selected>Select Your Trading Experience</option>
            <option value="I'm Completely New">I'm Completely New</option>
            <option value="0–6 Months">0–6 Months</option>
            <option value="6 Months–2 Years">6 Months–2 Years</option>
            <option value="2–5 Years">2–5 Years</option>
            <option value="5+ Years">5+ Years</option>
          </select>
          <p id="tradingExperience-error" class="mt-1 hidden text-xs font-medium text-red-600">Please select your trading experience.</p>
        </div>

        <label class="flex items-start gap-3 pt-2 text-sm text-slate-700">
          <input
            id="confirm-correct"
            type="checkbox"
            class="mt-0.5 h-4 w-4 rounded border-slate-300 text-blue-700 focus:ring-blue-700"
          />
          I confirm all the information provided is correct.
        </label>

        <button
          type="button"
          id="to-step-3"
          disabled
          aria-disabled="true"
          class="w-full rounded-full bg-gradient-to-r from-blue-600 to-emerald-500 px-6 py-3.5 text-sm font-bold text-white opacity-30 shadow-[0_12px_25px_-8px_rgba(29,78,216,0.5)] transition-all duration-300 pointer-events-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700"
        >
          Continue
        </button>
      </form>
    </div>

    <!-- STEP 3: Payment Method -->
    <div data-step="3" class="page-card hidden rounded-[2rem] border border-white/60 bg-white/70 p-6 shadow-[0_20px_60px_-20px_rgba(15,23,42,0.2)] backdrop-blur-xl sm:p-10">
      <button
        type="button"
        class="back-btn mb-6 inline-flex items-center gap-1.5 text-sm font-semibold text-slate-500 transition-colors hover:text-slate-900"
        data-back-to="2"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Back
      </button>

      <h2 class="text-center text-2xl font-extrabold tracking-tight text-slate-900">Payment Method</h2>
      <p class="mt-2 text-center text-sm text-slate-500">Choose how you'd like to pay.</p>

      <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4" id="method-list">
        <button type="button" data-method="bkash" aria-pressed="false" class="method-card flex flex-col items-center justify-center gap-2 rounded-2xl border-2 border-slate-200 bg-white px-3 py-5 shadow-sm transition-all focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700">
          <span class="flex h-16 w-full items-center justify-center">
            <img src="data:image/png;base64," alt="bKash" class="max-h-full max-w-full object-contain" />
          </span>
        </button>
        <button type="button" data-method="nagad" aria-pressed="false" class="method-card flex flex-col items-center justify-center gap-2 rounded-2xl border-2 border-slate-200 bg-white px-3 py-5 shadow-sm transition-all focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700">
          <span class="flex h-16 w-full items-center justify-center">
            <img src="data:image/png;base64," alt="Nagad" class="max-h-full max-w-full object-contain" />
          </span>
        </button>
        <button type="button" data-method="rocket" aria-pressed="false" class="method-card flex flex-col items-center justify-center gap-2 rounded-2xl border-2 border-slate-200 bg-white px-3 py-5 shadow-sm transition-all focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700">
          <span class="flex h-16 w-full items-center justify-center">
            <img src="data:image/png;base64," alt="Rocket" class="max-h-full max-w-full object-contain" />
          </span>
        </button>
        <button type="button" data-method="binance" aria-pressed="false" class="method-card flex flex-col items-center justify-center gap-2 rounded-2xl border-2 border-slate-200 bg-white px-3 py-5 shadow-sm transition-all focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700">
          <span class="flex h-16 w-full items-center justify-center">
            <img src="data:image/png;base64," alt="Binance UID" class="max-h-full max-w-full object-contain" />
          </span>
        </button>
        <button type="button" data-method="usdt_trc20" aria-pressed="false" class="method-card flex flex-col items-center justify-center gap-2 rounded-2xl border-2 border-slate-200 bg-white px-3 py-5 shadow-sm transition-all focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700">
          <span class="flex h-16 w-full items-center justify-center">
            <img src="data:image/png;base64," alt="USDT (TRC20)" class="max-h-full max-w-full object-contain" />
          </span>
        </button>
        <button type="button" data-method="usdt_bep20" aria-pressed="false" class="method-card flex flex-col items-center justify-center gap-2 rounded-2xl border-2 border-slate-200 bg-white px-3 py-5 shadow-sm transition-all focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700">
          <span class="flex h-16 w-full items-center justify-center">
            <img src="data:image/png;base64," alt="USDT (BEP20)" class="max-h-full max-w-full object-contain" />
          </span>
        </button>
      </div>

      <button
        type="button"
        id="to-step-4"
        disabled
        aria-disabled="true"
        class="mt-10 w-full rounded-full bg-gradient-to-r from-blue-600 to-emerald-500 px-6 py-3.5 text-sm font-bold text-white shadow-[0_12px_25px_-8px_rgba(29,78,216,0.5)] transition-transform hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700 disabled:cursor-not-allowed disabled:opacity-40"
      >
        Continue
      </button>
    </div>

    <!-- STEP 4: Payment Confirmation -->
    <div data-step="4" class="page-card hidden rounded-[2rem] border border-white/60 bg-white/70 p-6 shadow-[0_20px_60px_-20px_rgba(15,23,42,0.2)] backdrop-blur-xl sm:p-10">
      <button
        type="button"
        class="back-btn mb-6 inline-flex items-center gap-1.5 text-sm font-semibold text-slate-500 transition-colors hover:text-slate-900"
        data-back-to="3"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Back
      </button>

      <h2 class="text-center text-2xl font-extrabold tracking-tight text-slate-900">Payment Confirmation</h2>
      <p class="mt-2 text-center text-sm text-slate-500">Please review before continuing.</p>

      <div id="confirmation-card" class="mt-8 space-y-3 rounded-2xl border border-slate-200 bg-white p-5 transition-colors duration-300">
        <div id="confirm-logo" class="flex h-14 items-center justify-center"></div>
        <div class="flex items-center justify-between text-sm">
          <span class="font-medium text-slate-500">Selected Plan</span>
          <span class="relative inline-flex flex-none">
            <span id="confirm-plan" class="rounded-full bg-blue-100 px-3 py-1 text-xs font-bold text-blue-700"></span>
            <span
              id="confirm-plan-crown"
              class="absolute -right-2 -top-2 hidden h-5 w-5 items-center justify-center rounded-full bg-gradient-to-br from-amber-400 to-yellow-500 text-white shadow-[0_2px_6px_-1px_rgba(217,119,6,0.6)]"
            >
              <svg class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path d="M2.5 15.5 1 6l4.5 3L10 3l4.5 6 4.5-3-1.5 9.5Z" />
              </svg>
            </span>
          </span>
        </div>
        <div class="flex items-center justify-between text-sm">
          <span class="font-medium text-slate-500">Payment Method</span>
          <span id="confirm-method" class="font-bold text-slate-900"></span>
        </div>
        <div class="flex items-center justify-between border-t border-slate-100 pt-3 text-sm">
          <span class="font-medium text-slate-500">Amount</span>
          <span id="confirm-amount" class="text-2xl font-extrabold tracking-tight text-blue-700"></span>
        </div>
      </div>

      <div class="mt-5 rounded-2xl border border-blue-100 bg-blue-50 p-5">
        <p class="text-xs font-bold text-slate-900">Terms &amp; Conditions</p>
        <p class="mt-2 text-[11px] leading-relaxed text-slate-400">
          By continuing, you confirm that all information is correct. Payments are non-refundable.
          Mexo Trades is not responsible for payments sent to the wrong account, network, amount,
          or transaction details.
        </p>
      </div>

      <label class="mt-4 flex items-start gap-3 text-sm text-slate-700">
        <input
          id="terms-agree-checkbox"
          type="checkbox"
          class="mt-0.5 h-4 w-4 rounded border-slate-300 text-blue-700 focus:ring-blue-700"
        />
        I have read and agree to the Terms &amp; Conditions.
      </label>

      <button
        type="button"
        id="to-step-5"
        disabled
        aria-disabled="true"
        class="mt-6 w-full rounded-full bg-gradient-to-r from-blue-600 to-emerald-500 px-6 py-3.5 text-sm font-bold text-white opacity-30 shadow-[0_12px_25px_-8px_rgba(29,78,216,0.5)] transition-all duration-300 pointer-events-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700"
      >
        Continue
      </button>
    </div>

    <!-- STEP 5: Submit Payment -->
    <div data-step="5" class="page-card hidden rounded-[2rem] border border-white/60 bg-white/70 p-6 shadow-[0_20px_60px_-20px_rgba(15,23,42,0.2)] backdrop-blur-xl sm:p-10">
      <button
        type="button"
        class="back-btn mb-6 inline-flex items-center gap-1.5 text-sm font-semibold text-slate-500 transition-colors hover:text-slate-900"
        data-back-to="4"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Back
      </button>

      <h2 class="text-center text-2xl font-extrabold tracking-tight text-slate-900">Submit Payment</h2>
      <p class="mt-2 text-center text-sm text-slate-500">Send your payment, then confirm the details below.</p>

      <div
        id="payment-branding-card"
        class="mt-8 overflow-hidden rounded-[1.75rem] border border-slate-200/70 bg-white/80 shadow-[0_15px_45px_-20px_rgba(15,23,42,0.25)] backdrop-blur-xl transition-colors duration-500"
      >
        <!-- Waiting / Countdown -->
        <div id="payment-timer-section" class="relative border-b border-white/60 px-6 py-6 text-center">
          <div class="flex items-center justify-center gap-2 text-xs font-bold uppercase tracking-[0.15em] text-slate-500">
            <span id="payment-timer-icon" aria-hidden="true">♻️</span>
            <span id="payment-timer-label">Waiting For Payment...</span>
          </div>
          <p class="mt-3 text-[11px] font-semibold uppercase tracking-widest text-slate-400">Time Remaining</p>
          <div id="payment-timer" class="mt-1 text-5xl font-black tracking-tight">01:59</div>
        </div>

        <!-- Payment method logo -->
        <div class="flex justify-center pt-6">
          <div
            id="payment-method-logo"
            class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white p-2 shadow-[0_8px_20px_-8px_rgba(15,23,42,0.25)] ring-1"
          ></div>
        </div>

        <div id="destination-fields" class="space-y-3 px-6 pb-6 pt-5"></div>
      </div>

      <button
        type="button"
        id="payment-done-btn"
        disabled
        aria-disabled="true"
        class="mt-6 w-full rounded-full bg-gradient-to-r from-blue-600 to-emerald-500 px-6 py-3.5 text-sm font-bold text-white opacity-40 shadow-[0_12px_25px_-8px_rgba(29,78,216,0.5)] transition-all duration-300 pointer-events-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700"
      >
        Payment Sent
      </button>

      <div id="sender-fields" class="sender-fields-hidden mt-6 space-y-4">
        <div>
          <label id="sender-field-1-label" class="block text-sm font-semibold text-slate-700"></label>
          <input
            id="sender-field-1"
            type="text"
            disabled
            class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white/80 px-4 py-2.5 text-sm text-slate-900 transition-colors focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700 disabled:cursor-not-allowed disabled:bg-slate-50"
          />
          <p id="sender-field-1-error" class="mt-1 hidden text-xs font-medium text-red-600">
            Please enter a valid 11-digit number.
          </p>
        </div>
        <div>
          <label id="sender-field-2-label" class="block text-sm font-semibold text-slate-700"></label>
          <input
            id="sender-field-2"
            type="text"
            disabled
            class="mt-1.5 w-full rounded-xl border border-slate-300 bg-white/80 px-4 py-2.5 text-sm text-slate-900 transition-colors focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700 disabled:cursor-not-allowed disabled:bg-slate-50"
          />
        </div>
      </div>

      <label class="mt-6 flex items-start gap-3 text-sm text-slate-700">
        <input
          id="final-confirm-checkbox"
          type="checkbox"
          disabled
