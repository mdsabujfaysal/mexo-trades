  const uploadDropzone = document.getElementById("upload-dropzone") as HTMLDivElement;
  const proofFileInput = document.getElementById("proof-file-input") as HTMLInputElement;
  const uploadEmptyState = document.getElementById("upload-empty-state") as HTMLDivElement;
  const uploadPreviewState = document.getElementById("upload-preview-state") as HTMLDivElement;
  const uploadPreviewImg = document.getElementById("upload-preview-img") as HTMLImageElement;
  const uploadFileName = document.getElementById("upload-file-name") as HTMLParagraphElement;
  const uploadFileSize = document.getElementById("upload-file-size") as HTMLParagraphElement;
  const uploadErrorEl = document.getElementById("upload-error") as HTMLParagraphElement;
  const replaceScreenshotBtn = document.getElementById("replace-screenshot-btn") as HTMLButtonElement;
  const removeScreenshotBtn = document.getElementById("remove-screenshot-btn") as HTMLButtonElement;
  const submitDocumentationBtn = document.getElementById("submit-documentation-btn") as HTMLButtonElement;
  const submitDocBtnLabel = document.getElementById("submit-doc-btn-label") as HTMLSpanElement;
  const successPopupOverlay = document.getElementById("success-popup-overlay") as HTMLDivElement;

  const ACCEPTED_TYPES = ["image/png", "image/jpeg"];
  const MAX_FILE_SIZE_BYTES = 10 * 1024 * 1024; // 10MB

  function formatFileSize(bytes: number): string {
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
    return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
  }

  function showUploadError(message: string) {
    uploadErrorEl.textContent = message;
    uploadErrorEl.classList.remove("hidden");
  }

  function clearUploadError() {
    uploadErrorEl.textContent = "";
    uploadErrorEl.classList.add("hidden");
  }

  function setSubmitDocumentationEnabled(enabled: boolean) {
    submitDocumentationBtn.disabled = !enabled;
    submitDocumentationBtn.setAttribute("aria-disabled", String(!enabled));
    submitDocumentationBtn.classList.toggle("opacity-30", !enabled);
    submitDocumentationBtn.classList.toggle("pointer-events-none", !enabled);
    submitDocumentationBtn.classList.toggle("enabled", enabled);
  }

  function resetUploadArea() {
    proofFile = null;
    proofFileInput.value = "";
    uploadPreviewImg.src = "";
    uploadEmptyState.classList.remove("hidden");
    uploadPreviewState.classList.add("hidden");
    clearUploadError();
    setSubmitDocumentationEnabled(false);
  }

  function handleSelectedFile(file: File | undefined | null) {
    if (!file) return;

    const fileTypeOk =
      ACCEPTED_TYPES.includes(file.type) || /\.(png|jpe?g)$/i.test(file.name);

    if (!fileTypeOk) {
      showUploadError("Unsupported file type. Please upload a PNG, JPG or JPEG image.");
      setSubmitDocumentationEnabled(false);
      return;
    }

    if (file.size > MAX_FILE_SIZE_BYTES) {
      showUploadError("File is too large. Maximum allowed size is 10MB.");
      setSubmitDocumentationEnabled(false);
      return;
    }

    clearUploadError();
    proofFile = file;

    const reader = new FileReader();
    reader.onload = () => {
      uploadPreviewImg.src = reader.result as string;
      uploadFileName.textContent = file.name;
      uploadFileSize.textContent = formatFileSize(file.size);
      uploadEmptyState.classList.add("hidden");
      uploadPreviewState.classList.remove("hidden");
      setSubmitDocumentationEnabled(true);
    };
    reader.readAsDataURL(file);
  }

  uploadDropzone.addEventListener("click", (event) => {
    // Avoid re-opening the file picker when the Replace/Remove buttons are clicked.
    if ((event.target as HTMLElement).closest("#replace-screenshot-btn, #remove-screenshot-btn")) {
      return;
    }
    proofFileInput.click();
  });

  proofFileInput.addEventListener("change", () => {
    handleSelectedFile(proofFileInput.files?.[0]);
  });

  ["dragenter", "dragover"].forEach((eventName) => {
    uploadDropzone.addEventListener(eventName, (event) => {
      event.preventDefault();
      event.stopPropagation();
      uploadDropzone.classList.add("drag-active");
    });
  });

  ["dragleave", "dragend"].forEach((eventName) => {
    uploadDropzone.addEventListener(eventName, (event) => {
      event.preventDefault();
      event.stopPropagation();
      uploadDropzone.classList.remove("drag-active");
    });
  });

  uploadDropzone.addEventListener("drop", (event) => {
    event.preventDefault();
    event.stopPropagation();
    uploadDropzone.classList.remove("drag-active");
    const file = event.dataTransfer?.files?.[0];
    if (file) {
      handleSelectedFile(file);
    }
  });

  replaceScreenshotBtn.addEventListener("click", (event) => {
    event.stopPropagation();
    proofFileInput.click();
