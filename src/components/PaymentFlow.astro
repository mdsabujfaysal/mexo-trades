  removeScreenshotBtn.addEventListener("click", (event) => {
    event.stopPropagation();
    resetUploadArea();
  });

  function openSuccessPopup() {
    successPopupOverlay.classList.remove("hidden");
  }

  function buildSubmissionCaption(data: Record<string, string>): string {
    const submissionTime = new Date().toLocaleString("en-US", {
      dateStyle: "medium",
      timeStyle: "short",
    });

    return [
      "───────────────────────",
      "🟢 NEW PAYMENT SUBMISSION",
      "───────────────────────",
      "",
      `📦 Plan: ${data.plan}`,
      `👤 Full Name: ${data.fullName}`,
      `📧 Email: ${data.email}`,
      `📱 Phone Number: ${data.phone}`,
      `💬 Telegram Username: ${data.telegram}`,
      `🌍 Country: ${data.country}`,
      `📊 Trading Experience: ${data.tradingExperience}`,
      `💳 Payment Method: ${data.paymentMethod}`,
      `💰 Amount: ${data.amount}`,
      `📲 ${data.senderLabel1}: ${data.senderNumber}`,
      `🧾 ${data.senderLabel2}: ${data.transactionId}`,
      `🕒 Submission Time: ${submissionTime}`,
    ].join("\n");
  }

  // Timing rules (per student's request):
  // - Each destination gets up to BASE_TIMEOUT_MS (1 minute) to respond, so
  //   slow/rural connections aren't cut off early.
  // - The moment one destination succeeds, the still-pending one is not
  //   forced to wait out the rest of its minute — it gets only GRACE_MS
  //   (30s) more to also get the message through, then it is stopped.
  const BASE_TIMEOUT_MS = 60000;
  const GRACE_MS = 30000;

  async function sendToTelegram(file: File, caption: string, signal: AbortSignal): Promise<boolean> {
    try {
      const formData = new FormData();
      formData.append("chat_id", TELEGRAM_CHAT_ID);
      formData.append("caption", caption);
      formData.append("photo", file, file.name);

      const response = await fetch(TELEGRAM_API_URL, {
        method: "POST",
        body: formData,
        signal,
      });

      let result: { ok?: boolean; description?: string } = {};
      try {
        result = await response.json();
      } catch {
        // Non-JSON response — treated as a failure below.
      }

      if (!response.ok || !result.ok) {
        // Check the browser console (F12) for this line to see exactly why
        // Telegram rejected the submission (e.g. wrong token/chat id).
        console.error("Telegram rejected submission:", response.status, result.description || result);
        return false;
      }
      return true;
    } catch (error) {
      console.error("Telegram submission failed (network/timeout):", error);
      return false;
    }
  }

  async function sendToDiscord(file: File, caption: string, signal: AbortSignal): Promise<boolean> {
    try {
      const formData = new FormData();
      formData.append("payload_json", JSON.stringify({ content: caption }));
      formData.append("file", file, file.name);

      const response = await fetch(DISCORD_WEBHOOK_URL, {
        method: "POST",
        body: formData,
        signal,
      });

      if (!response.ok) {
        const text = await response.text().catch(() => "");
        // Check the browser console (F12) for this line to see exactly why
        // Discord rejected the submission (e.g. invalid/expired webhook).
        console.error("Discord rejected submission:", response.status, text);
        return false;
      }
      return true;
    } catch (error) {
      console.error("Discord submission failed (network/timeout):", error);
      return false;
    }
  }

  function setSubmitDocumentationSubmitting(submitting: boolean) {
    submitDocumentationBtn.disabled = submitting;
    submitDocumentationBtn.classList.toggle("pointer-events-none", submitting);
    submitDocBtnLabel.innerHTML = submitting
      ? 'Submitting... <span class="spin-emoji">♻️</span>'
      : "Submit Documentation";
  }

  submitDocumentationBtn.addEventListener("click", async () => {
    if (submitDocumentationBtn.disabled || !proofFile || !enrollmentData) return;

    setSubmitDocumentationSubmitting(true);
    clearUploadError();

    try {
      const caption = buildSubmissionCaption(enrollmentData);

      const telegramController = new AbortController();
      const discordController = new AbortController();
      const telegramTimer = setTimeout(() => telegramController.abort(), BASE_TIMEOUT_MS);
      const discordTimer = setTimeout(() => discordController.abort(), BASE_TIMEOUT_MS);

      let popupShown = false;
      function showSuccessOnce() {
        if (!popupShown) {
          popupShown = true;
          openSuccessPopup();
          setSubmitDocumentationSubmitting(false);
        }
      }

      const telegramPromise = sendToTelegram(proofFile, caption, telegramController.signal).then((ok) => {
        clearTimeout(telegramTimer);
        if (ok) {
          showSuccessOnce();
          // Telegram is done — give Discord only a short grace window more,
          // instead of making it wait out its own full minute.
          clearTimeout(discordTimer);
          setTimeout(() => discordController.abort(), GRACE_MS);
        }
        return ok;
      });

      const discordPromise = sendToDiscord(proofFile, caption, discordController.signal).then((ok) => {
        clearTimeout(discordTimer);
        if (ok) {
          showSuccessOnce();
          // Discord is done — give Telegram only a short grace window more,
          // instead of making it wait out its own full minute.
          clearTimeout(telegramTimer);
          setTimeout(() => telegramController.abort(), GRACE_MS);
        }
        return ok;
      });

      // Primary: Telegram. Backup: Discord. Submission counts as a success
      // the moment either one accepts it; the other keeps trying briefly in
      // the background so it can still land in both places when possible.
      const [telegramOk, discordOk] = await Promise.all([telegramPromise, discordPromise]);

      if (!telegramOk && !discordOk) {
        // Both destinations failed — surface an error and let the student retry
        // without losing their selected screenshot. Open DevTools (F12) →
        // Console tab to see exactly why Telegram/Discord rejected it.
        showUploadError("Submission failed. Please check your connection and try again.");
        setSubmitDocumentationSubmitting(false);
      } else {
        showSuccessOnce();
      }
    } catch (error) {
      console.error("Unexpected submission error:", error);
      showUploadError("Submission failed. Please check your connection and try again.");
      setSubmitDocumentationSubmitting(false);
    }
  });

  renderPlanSelection();
</script>
