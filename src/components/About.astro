---
const stats = [
  {
    value: "6+",
    label: "Years of Market Education",
    icon: "M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0-5.94-2.28m5.94 2.28-2.28 5.941",
  },
  {
    value: "100+",
    label: "Traders Mentored",
    icon: "M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z",
  },
  {
    value: "2",
    label: "Mentorship Programs",
    icon: "M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25",
  },
];
---

<section id="about" class="bg-slate-50 py-14">
  <div id="about-animate" class="mx-auto max-w-5xl translate-y-10 px-6 opacity-0 transition-all duration-700 ease-out">
    <div class="text-center">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-600">About MEXO</p>
      <h2 class="mx-auto mt-2 max-w-xl text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">
        Beyond Public Strategies. Built From Real Market Experience.
      </h2>
    </div>

    <div class="mt-8 grid items-center gap-8 md:grid-cols-2">
      <div class="relative mx-auto aspect-[4/5] w-full max-w-xs overflow-hidden rounded-3xl shadow-lg">
        <img
          src="/images/mexo-founder.jpg"
          alt="Md Sabuj Faysal, Founder of MEXO, at his trading desk"
          class="absolute inset-0 h-full w-full object-cover object-top"
        />

        <div
          class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-slate-900/95 via-slate-900/40 to-transparent"
          aria-hidden="true"
        >
        </div>

        <div class="relative flex h-full flex-col items-start justify-end gap-1 px-6 pb-6">
          <span class="text-5xl font-black leading-none tracking-tight text-sky-400">MEXO</span>
          <span class="mt-1 text-sm font-semibold tracking-wide text-white">
            Master Execution <span class="italic text-sky-400">Optimization</span>
          </span>
        </div>
      </div>

      <div>
        <p class="text-base font-bold text-slate-900">MEXO</p>
        <p class="mt-1 text-sm text-slate-500">Market Execution Optimization</p>
        <p class="mt-2 text-xs font-semibold text-emerald-600">
          Algorithmic Thinking • Professional Trading Education
        </p>

        <p class="mt-4 text-sm leading-relaxed text-slate-600">
          Most traders never learn how the market really works. MEXO was built through real market
          research and practical trading experience. Led by{" "}
          <a href="/team/sabuj-faysal" class="font-semibold text-blue-700 underline decoration-blue-200 decoration-2 underline-offset-2 transition-colors hover:text-emerald-600 hover:decoration-emerald-300">Md Sabuj Faysal</a>, with support from{" "}
          <a href="/team/faizur-rahman-shaikat" class="font-semibold text-blue-700 underline decoration-blue-200 decoration-2 underline-offset-2 transition-colors hover:text-emerald-600 hover:decoration-emerald-300">Faizur Rahman Shaikat</a> and{" "}
          <a href="/team/samsul-arefin" class="font-semibold text-blue-700 underline decoration-blue-200 decoration-2 underline-offset-2 transition-colors hover:text-emerald-600 hover:decoration-emerald-300">Md Samsul Arefin</a>, we provide live
          mentorship to help traders understand the market—not just follow strategies.
        </p>

        <div class="mt-6 grid grid-cols-3 gap-4 border-t border-slate-200 pt-6">
          {
            stats.map((stat) => (
              <div>
                <svg
                  class="h-4 w-4 text-blue-700"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d={stat.icon} />
                </svg>
                <p class="mt-1.5 text-xl font-extrabold text-slate-900">{stat.value}</p>
                <p class="text-xs text-slate-500">{stat.label}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Slide-up-and-fade-in animation the first time this section scrolls into view.
  const animatedEl = document.getElementById("about-animate");
  if (animatedEl) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animatedEl.classList.remove("translate-y-10", "opacity-0");
            animatedEl.classList.add("translate-y-0", "opacity-100");
          } else {
            animatedEl.classList.add("translate-y-10", "opacity-0");
            animatedEl.classList.remove("translate-y-0", "opacity-100");
          }
        });
      },
      { threshold: 0.2 }
    );
    observer.observe(animatedEl);
  }
</script>
