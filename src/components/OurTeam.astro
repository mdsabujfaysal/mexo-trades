---
// Our Team section — standalone component, matching the About section's design.
// Cards link to individual mentor profile pages at /team/{slug},
// rendered by src/pages/team/*.astro using src/components/TeamProfile.astro.
//
// Mentor data lives in src/data/team.ts (single source of truth, shared with
// the individual profile pages) — edit that file to add/change mentors.
import { team } from "@/data/team";
---

<section id="our-team" class="bg-white py-14">
  <div id="team-animate" class="mx-auto max-w-5xl translate-y-10 px-6 opacity-0 transition-all duration-700 ease-out">
    <div class="text-center">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-600">Our Team</p>
      <h2 class="mx-auto mt-2 max-w-xl text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">
        The People Behind MEXO
      </h2>
    </div>

    <div class="mt-14 grid justify-items-center gap-y-10 sm:grid-cols-3 sm:gap-x-6">
      {
        team.map((member) => (
          <div class="group flex flex-col items-center">
            {/* Circular photo with Instagram-style blue gradient ring */}
            <a
              href={`/team/${member.slug}`}
              aria-label={member.name}
              class="relative block h-40 w-40 shrink-0 rounded-full bg-gradient-to-tr from-blue-500 via-sky-400 to-indigo-500 p-[3px] shadow-[0_10px_25px_-8px_rgba(16,24,40,0.25)] transition-transform duration-300 ease-out group-hover:-translate-y-1.5 sm:h-44 sm:w-44"
            >
              {/* white gap between gradient ring and photo */}
              <div class="h-full w-full rounded-full bg-white p-[3px]">
                <div class="relative h-full w-full overflow-hidden rounded-full">
                  {member.photo ? (
                    <img
                      src={member.photo}
                      alt={member.name}
                      class="h-full w-full object-cover object-top"
                    />
                  ) : (
                    <div
                      class="flex h-full w-full items-center justify-center"
                      style="background: linear-gradient(135deg, #0f172a 0%, #0f172a 60%, rgba(37,99,235,0.3) 100%);"
                    >
                      <span class="text-xl font-black tracking-tight text-white">{member.initials}</span>
                    </div>
                  )}

                  {/* Designation shown only on hover/tap */}
                  <div class="absolute inset-0 flex items-center justify-center rounded-full bg-slate-900/75 px-3 text-center opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                    <p class="text-xs font-semibold leading-snug text-white">{member.designation}</p>
                  </div>
                </div>
              </div>
            </a>

            {/* Name, always visible */}
            <p class="mt-4 text-base font-bold text-slate-900">{member.name}</p>

            {/* Social icons, always visible. Until a real social link is added in
                team.ts, icons fall back to this mentor's profile page. */}
            {(() => {
              const profileHref = `/team/${member.slug}`;
              const fb = member.social?.facebook || profileHref;
              const li = member.social?.linkedin || profileHref;
              const ig = member.social?.instagram || profileHref;
              const isFb = !!member.social?.facebook;
              const isLi = !!member.social?.linkedin;
              const isIg = !!member.social?.instagram;
              return (
                <div class="mt-3 flex items-center gap-2.5">
                  <a
                    href={fb}
                    target={isFb ? "_blank" : undefined}
                    rel={isFb ? "noopener noreferrer" : undefined}
                    aria-label={isFb ? `${member.name} on Facebook` : `View ${member.name}'s profile`}
                    class="flex h-9 w-9 items-center justify-center rounded-full bg-white shadow-[0_4px_10px_-2px_rgba(16,24,40,0.15)] ring-1 ring-slate-100 transition-transform duration-200 hover:-translate-y-0.5"
                  >
                    <svg viewBox="0 0 448 512" class="h-4 w-4 fill-[#1877F2]">
                      <path d="M448,56.7v398.5c0,13.7-11.1,24.7-24.7,24.7H309.1V306.5h58.2l8.7-67.6h-67v-43.2c0-19.6,5.4-32.9,33.5-32.9h35.8v-60.5c-6.2-0.8-27.4-2.7-52.2-2.7c-51.6,0-87,31.5-87,89.4v49.9h-58.4v67.6h58.4V480H24.7C11.1,480,0,468.9,0,455.3V56.7C0,43.1,11.1,32,24.7,32h398.5C436.9,32,448,43.1,448,56.7z" />
                    </svg>
                  </a>
                  <a
                    href={li}
                    target={isLi ? "_blank" : undefined}
                    rel={isLi ? "noopener noreferrer" : undefined}
                    aria-label={isLi ? `${member.name} on LinkedIn` : `View ${member.name}'s profile`}
                    class="flex h-9 w-9 items-center justify-center rounded-full bg-white shadow-[0_4px_10px_-2px_rgba(16,24,40,0.15)] ring-1 ring-slate-100 transition-transform duration-200 hover:-translate-y-0.5"
                  >
                    <svg viewBox="0 0 448 512" class="h-4 w-4 fill-[#0A66C2]">
                      <path d="M416,32H31.9C14.3,32,0,46.5,0,64.3v383.4C0,465.5,14.3,480,31.9,480H416c17.6,0,32-14.5,32-32.3V64.3C448,46.5,433.6,32,416,32z M135.4,416H69V202.2h66.5V416z M102.2,173c-21.3,0-38.5-17.3-38.5-38.5C63.7,113.2,80.9,96,102.2,96c21.2,0,38.5,17.2,38.5,38.5C140.7,155.7,123.4,173,102.2,173z M416,416h-66.4V312c0-24.8-0.5-56.7-34.5-56.7c-34.6,0-39.9,27-39.9,54.9V416h-66.4V202.2h63.7v29.2h0.9c8.9-16.8,30.6-34.5,62.9-34.5c67.2,0,79.7,44.3,79.7,101.9V416z" />
                    </svg>
                  </a>
                  <a
                    href={ig}
                    target={isIg ? "_blank" : undefined}
                    rel={isIg ? "noopener noreferrer" : undefined}
                    aria-label={isIg ? `${member.name} on Instagram` : `View ${member.name}'s profile`}
                    class="flex h-9 w-9 items-center justify-center rounded-full bg-white shadow-[0_4px_10px_-2px_rgba(16,24,40,0.15)] ring-1 ring-slate-100 transition-transform duration-200 hover:-translate-y-0.5"
                  >
                    <svg viewBox="0 0 448 512" class="h-4 w-4">
                      <defs>
                        <linearGradient id={`ig-${member.slug}`} x1="0%" y1="100%" x2="100%" y2="0%">
                          <stop offset="0%" stop-color="#FED576" />
                          <stop offset="26%" stop-color="#F47133" />
                          <stop offset="61%" stop-color="#BC3081" />
                          <stop offset="100%" stop-color="#4C63D2" />
                        </linearGradient>
                      </defs>
                      <path
                        fill={`url(#ig-${member.slug})`}
                        d="M224.1,141c-63.6,0-114.9,51.3-114.9,114.9s51.3,114.9,114.9,114.9S339,319.5,339,255.9S287.7,141,224.1,141z M224.1,338c-45.3,0-82.1-36.8-82.1-82.1s36.8-82.1,82.1-82.1s82.1,36.8,82.1,82.1S269.4,338,224.1,338z M340.1,109.4c-14.9,0-27,12.1-27,27c0,14.9,12.1,27,27,27c14.9,0,27-12,27-27C367.1,121.5,355,109.4,340.1,109.4z M448,157.6c-0.5-32.3-7.9-60.9-31.9-84.9c-24-24-52.6-31.4-84.9-31.9c-33.4-1.9-133.6-1.9-167,0c-32.3,0.5-60.8,7.9-84.9,31.8s-31.4,52.6-31.9,84.9c-1.9,33.4-1.9,133.6,0,167c0.5,32.3,7.9,60.9,31.9,84.9s52.6,31.4,84.9,31.9c33.4,1.9,133.6,1.9,167,0c32.3-0.5,60.9-7.9,84.9-31.9c24-24,31.4-52.6,31.9-84.9c1.9-33.4,1.9-133.5,0-167z M398.8,388c-7,17.7-20.5,31.2-38.3,38.3c-26.5,10.5-89.4,8.1-118.7,8.1s-92.3,2.3-118.7-8.1c-17.7-7-31.2-20.5-38.3-38.3c-10.5-26.5-8.1-89.4-8.1-118.7s-2.3-92.3,8.1-118.7c7-17.7,20.5-31.2,38.3-38.3c26.5-10.5,89.4-8.1,118.7-8.1s92.3-2.3,118.7,8.1c17.7,7,31.2,20.5,38.3,38.3c10.5,26.5,8.1,89.4,8.1,118.7S409.3,361.5,398.8,388z"
                      />
                    </svg>
                  </a>
                </div>
              );
            })()}
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Slide-up-and-fade-in animation the first time this section scrolls into view.
  const animatedEl = document.getElementById("team-animate");
  if (animatedEl) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animatedEl.classList.remove("translate-y-10", "opacity-0");
            animatedEl.classList.add("translate-y-0", "opacity-100");
          } else {
            animatedEl.classList.add("translate-y-10", "opacity-0");
            animatedEl.classList.remove("translate-y-0", "opacity-100");
          }
        });
      },
      { threshold: 0.2 }
    );
    observer.observe(animatedEl);
  }
</script>
