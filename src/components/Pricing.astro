---
const features = [
  { text: "Advanced Trading Concept", icon: "trend" },
  { text: "Institutional Live Workflow", icon: "bank" },
  { text: "Strategy & Trade Planning", icon: "target" },
  { text: "Live Chart Entry Verification", icon: "sliders" },
  { text: "Funded Challenge Guidance", icon: "trophy" },
  { text: "Lifetime Community Access", icon: "users" },
];

const plans = [
  {
    id: "free",
    name: "Free Access",
    meta: "10 Days · Foundation",
    price: "FREE",
    priceNote: "$0 fee",
    href: "/free-registration",
    selected: true,
  },
  {
    id: "premium",
    name: "Premium",
    meta: "1 Month · Full Program",
    price: "$100",
    priceNote: "one-time",
    href: "/payment?plan=premium",
    selected: false,
  },
];
---

<section id="pricing" class="relative overflow-hidden bg-white py-16 sm:py-24">
  <style>
    @import url("https://fonts.googleapis.com/css2?family=Reenie+Beanie&family=Merriweather:wght@400;700&display=swap");
    .script-live {
      font-family: "Reenie Beanie", cursive;
      display: inline-block;
      font-size: 1.5em;
      transform: rotate(-3deg);
    }
    .feature-text {
      font-family: "Merriweather", serif;
      font-weight: 400;
    }
  </style>

  <div
    id="pricing-animate"
    class="mx-auto max-w-5xl px-6 translate-y-10 opacity-0 transition-all duration-700 ease-out"
  >
    <!-- ============ UNIFIED CARD (heading + features + pricing) ============ -->
    <div class="relative overflow-hidden rounded-3xl bg-white shadow-[0_20px_60px_-15px_rgba(15,23,42,0.12)] ring-1 ring-slate-100">
      <div class="grid gap-10 p-8 sm:p-10 md:grid-cols-2 md:gap-8">
        <!-- LEFT: HEADING + FEATURES -->
        <div class="flex h-full flex-col">
          <span class="inline-flex items-center gap-2 rounded-full bg-indigo-50 px-4 py-1.5 text-xs font-bold tracking-wide">
            <span class="text-blue-600">ONE ROADMAP.</span>
            <span class="text-slate-600">COMPLETE JOURNEY</span>
          </span>

          <h2 class="mt-4 text-3xl font-black leading-[1.05] tracking-tight sm:text-4xl lg:text-5xl">
            <span class="text-slate-900">6 Weeks</span>
            <span class="script-live text-blue-600"> Live</span>
            <br />
            <span class="whitespace-nowrap">
              <span class="text-slate-900">Education </span><span class="bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">Program</span>
            </span>
          </h2>

          <div class="relative my-6 h-px bg-slate-200">
            <span class="absolute left-1/2 top-1/2 flex h-6 w-6 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white">
              <svg class="h-4 w-4 text-slate-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 12h4l2 6 4-14 2 8h8" />
              </svg>
            </span>
          </div>

          <div class="rounded-2xl bg-gradient-to-br from-blue-500/15 to-purple-500/15 p-5">
            <ul class="space-y-2">
              {
                features.map((feature) => (
                  <li class="feature-text flex items-center gap-2.5 text-[15px] text-slate-800">
                    <span class="flex h-6 w-6 flex-none items-center justify-center rounded-full bg-blue-50 text-blue-600">
                      {feature.icon === "trend" && (
                        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="3 17 9 11 13 15 21 7" />
                          <polyline points="15 7 21 7 21 13" />
                        </svg>
                      )}
                      {feature.icon === "bank" && (
                        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M3 10l9-6 9 6" />
                          <path d="M4 10v9M9 10v9M15 10v9M20 10v9" />
                          <path d="M2 21h20" />
                        </svg>
                      )}
                      {feature.icon === "target" && (
                        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <circle cx="12" cy="12" r="8" />
                          <circle cx="12" cy="12" r="4" />
                          <circle cx="12" cy="12" r="0.6" fill="currentColor" />
                        </svg>
                      )}
                      {feature.icon === "sliders" && (
                        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M4 6h9M17 6h3M4 18h3M11 18h9" />
                          <circle cx="13" cy="6" r="2" />
                          <circle cx="7" cy="18" r="2" />
                        </svg>
                      )}
                      {feature.icon === "trophy" && (
                        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M8 4h8v5a4 4 0 01-8 0V4z" />
                          <path d="M8 5H5a3 3 0 003 3M16 5h3a3 3 0 01-3 3" />
                          <path d="M12 13v3M9 20h6M10 16.5h4a2 2 0 012 2V20H8v-1.5a2 2 0 012-2z" />
                        </svg>
                      )}
                      {feature.icon === "users" && (
                        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="9" cy="8" r="3" />
                          <path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6" />
                          <circle cx="17" cy="9" r="2.5" />
                          <path d="M15 14.2c2.4.4 4 2.3 4 4.8" />
                        </svg>
                      )}
                    </span>
                    {feature.text}
                  </li>
                ))
              }
            </ul>
          </div>

          <a href="/free-registration" class="mt-auto inline-block pt-6 text-xs font-bold text-blue-600 underline underline-offset-4">
            Join Now Free →
          </a>
        </div>

        <!-- RIGHT: PRICING -->
        <div class="flex h-full flex-col justify-end gap-4">
          <!-- Plan options: clicking only SELECTS a plan, it does not navigate -->
          <div id="plan-options" role="radiogroup" aria-label="Choose a plan">
            {
              plans.map((plan) => (
                <button
                  type="button"
                  data-plan-option
                  data-plan-id={plan.id}
                  data-href={plan.href}
                  role="radio"
                  aria-checked={plan.selected ? "true" : "false"}
                  class={`mb-4 flex w-full cursor-pointer items-center justify-between rounded-2xl p-4 text-left transition-all last:mb-0 ${
                    plan.selected
                      ? "bg-gradient-to-r from-indigo-500/15 to-purple-500/15 ring-2 ring-indigo-400"
                      : "ring-1 ring-slate-200 hover:ring-slate-300"
                  }`}
                >
                  <span class="flex items-center gap-3">
                    <span
                      data-plan-dot
                      class={`flex h-5 w-5 flex-none items-center justify-center rounded-full transition-colors ${
                        plan.selected ? "bg-blue-600" : "ring-1 ring-slate-300"
                      }`}
                    >
                      <svg
                        data-plan-check
                        class={`h-3 w-3 text-white ${plan.selected ? "" : "hidden"}`}
                        viewBox="0 0 20 20"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M16.704 5.29a1 1 0 010 1.42l-7.5 7.5a1 1 0 01-1.42 0l-3.5-3.5a1 1 0 111.42-1.42L8.5 12.08l6.79-6.79a1 1 0 011.41 0z"
                          clip-rule="evenodd"
                        />
                      </svg>
                    </span>
                    <span>
                      <span class="block text-sm font-bold text-slate-900">{plan.name}</span>
                      <span data-plan-meta class={`block text-xs font-medium ${plan.selected ? "text-blue-600" : "text-slate-500"}`}>{plan.meta}</span>
                    </span>
                  </span>
                  <span class="text-right">
                    <span data-plan-price class={`block text-lg font-extrabold ${plan.selected ? "text-blue-600" : "text-slate-900"}`}>{plan.price}</span>
                    <span class="block text-[10px] text-slate-500">{plan.priceNote}</span>
                  </span>
                </button>
              ))
            }
          </div>

          <!-- Get Started: navigates to whichever plan is currently selected -->
          <a
            id="get-started-btn"
            href={plans.find((p) => p.selected)?.href}
            class="mt-2 block rounded-full bg-gradient-to-r from-blue-600 to-purple-600 px-6 py-4 text-center text-sm font-bold text-white shadow-[0_12px_25px_-8px_rgba(79,70,229,0.5)] transition-transform hover:-translate-y-0.5"
          >
            Get Started →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initPlanSelector() {
    const options = document.querySelectorAll<HTMLButtonElement>("[data-plan-option]");
    const getStartedBtn = document.getElementById("get-started-btn") as HTMLAnchorElement | null;

    options.forEach((option) => {
      option.addEventListener("click", () => {
        // Update selected state on all options
        options.forEach((opt) => {
          const isSelected = opt === option;
          opt.setAttribute("aria-checked", isSelected ? "true" : "false");

          const dot = opt.querySelector<HTMLElement>("[data-plan-dot]");
          const check = opt.querySelector<SVGElement>("[data-plan-check]");
          const meta = opt.querySelector<HTMLElement>("[data-plan-meta]");
          const price = opt.querySelector<HTMLElement>("[data-plan-price]");

          if (isSelected) {
            opt.classList.add("bg-gradient-to-r", "from-indigo-500/15", "to-purple-500/15", "ring-2", "ring-indigo-400");
            opt.classList.remove("ring-1", "ring-slate-200", "hover:ring-slate-300");
            dot?.classList.add("bg-blue-600");
            dot?.classList.remove("ring-1", "ring-slate-300");
            check?.classList.remove("hidden");
            meta?.classList.add("text-blue-600");
            meta?.classList.remove("text-slate-500");
            price?.classList.add("text-blue-600");
            price?.classList.remove("text-slate-900");
          } else {
            opt.classList.remove("bg-gradient-to-r", "from-indigo-500/15", "to-purple-500/15", "ring-2", "ring-indigo-400");
            opt.classList.add("ring-1", "ring-slate-200", "hover:ring-slate-300");
            dot?.classList.remove("bg-blue-600");
            dot?.classList.add("ring-1", "ring-slate-300");
            check?.classList.add("hidden");
            meta?.classList.remove("text-blue-600");
            meta?.classList.add("text-slate-500");
            price?.classList.remove("text-blue-600");
            price?.classList.add("text-slate-900");
          }
        });

        // Point "Get Started" to the newly selected plan's destination
        const href = option.getAttribute("data-href");
        if (getStartedBtn && href) {
          getStartedBtn.setAttribute("href", href);
        }
      });
    });
  }

  function initScrollAnimation() {
    const animatedEl = document.getElementById("pricing-animate");
    if (!animatedEl) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animatedEl.classList.remove("translate-y-10", "opacity-0");
            animatedEl.classList.add("translate-y-0", "opacity-100");
          } else {
            animatedEl.classList.add("translate-y-10", "opacity-0");
            animatedEl.classList.remove("translate-y-0", "opacity-100");
          }
        });
      },
      { threshold: 0.2 }
    );
    observer.observe(animatedEl);
  }

  document.addEventListener("astro:page-load", initPlanSelector);
  document.addEventListener("astro:page-load", initScrollAnimation);
  initPlanSelector();
  initScrollAnimation();
</script>
