---
const premiumFeatures = [
  "18 Live Master Classes",
  "18 Live Support Sessions",
  "One-to-One Support",
  "Unlock Core Trading Concepts",
  "Advanced Market Concepts",
  "Complete Trade Planning",
  "Live Entry Verification",
  "Prop Firm Challenge Guidance",
  "Lifetime Community Access",
];
---

<section id="pricing" class="bg-white py-8">
  <div id="pricing-animate" class="mx-auto max-w-6xl translate-y-10 px-6 opacity-0 transition-all duration-700 ease-out">
    <div class="mx-auto max-w-5xl rounded-[2rem] bg-slate-50 p-5 shadow-[0_10px_50px_-15px_rgba(15,23,42,0.1)] sm:p-8">
      <div class="text-center">
        <h2 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
          Choose Your Mentorship
        </h2>
        <p class="mt-3 text-base text-slate-500">
          Everything you need to become a confident and successful trader.
        </p>
      </div>

      <div class="mx-auto mt-6 flex max-w-md items-center justify-center gap-3">
        <span class="flex items-center gap-1.5 text-xs font-semibold text-slate-700">
          <span aria-hidden="true">👤</span> Your Journey
        </span>

        <span
          class="relative inline-flex h-5 w-9 flex-none items-center rounded-full bg-gradient-to-r from-blue-600 to-emerald-500 shadow-inner"
          role="img"
          aria-label="Toggle switched on"
        >
          <span class="inline-block h-4 w-4 translate-x-4 rounded-full bg-white shadow"></span>
        </span>

        <span class="flex items-center gap-1.5 text-xs font-semibold text-slate-700">
          <span aria-hidden="true">👨‍🎓</span> Successful Trader
        </span>
      </div>

      <div class="mx-auto mt-24 flex max-w-md items-stretch justify-center">
        <div class="relative z-10 flex flex-col rounded-3xl bg-gradient-to-br from-blue-600 to-emerald-500 p-7 text-white shadow-[0_25px_70px_-15px_rgba(5,150,105,0.5)]">
          <span class="absolute -top-3 left-8 rounded-full bg-white px-3 py-1 text-xs font-bold text-emerald-700">
            PRO
          </span>

          <h3 class="text-xl font-bold text-white">Premium</h3>
          <p class="mt-1 text-sm text-blue-50">Unlock Core Trading Concepts</p>

          <div class="mt-6 flex items-baseline gap-1">
            <span class="text-5xl font-extrabold text-white">$149</span>
            <span class="text-base font-medium text-blue-100">/2 Months</span>
          </div>

          <a
            href="/payment?plan=premium"
            class="mt-6 block rounded-full bg-white px-6 py-3 text-center text-sm font-bold text-emerald-700 shadow-[0_12px_25px_-8px_rgba(0,0,0,0.25)] transition-transform hover:-translate-y-0.5"
          >
            Join Premium Mentorship
          </a>

          <ul class="mt-8 flex-1 space-y-4">
            {
              premiumFeatures.map((feature) => (
                <li class="flex items-center gap-3 text-sm text-blue-50">
                  <span class="flex h-6 w-6 flex-none items-center justify-center rounded-full bg-white/20 text-white">
                    <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                      <path
                        fill-rule="evenodd"
                        d="M16.704 5.29a1 1 0 010 1.42l-7.5 7.5a1 1 0 01-1.42 0l-3.5-3.5a1 1 0 111.42-1.42L8.5 12.08l6.79-6.79a1 1 0 011.41 0z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </span>
                  {feature}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Slide-up-and-fade-in animation the first time this section scrolls into view.
  const animatedEl = document.getElementById("pricing-animate");
  if (animatedEl) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animatedEl.classList.remove("translate-y-10", "opacity-0");
            animatedEl.classList.add("translate-y-0", "opacity-100");
          } else {
            animatedEl.classList.add("translate-y-10", "opacity-0");
            animatedEl.classList.remove("translate-y-0", "opacity-100");
          }
        });
      },
      { threshold: 0.2 }
    );
    observer.observe(animatedEl);
  }
</script>
