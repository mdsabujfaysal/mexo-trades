---
const premiumFeatures = [
  "18 Live Master Classes",
  "18 Live Support Sessions",
  "One-to-One Support",
  "Unlock Core Trading Concepts",
  "Advanced Market Concepts",
  "Complete Trade Planning",
  "Live Entry Verification",
  "Prop Firm Challenge Guidance",
  "Lifetime Community Access",
];

const freeFeatures = [
  "Program Duration: 15 Days",
  "7 Live Mentorship Sessions",
  "Personalized Guidance",
  "Ask Your Questions",
  "Basic Trading Concepts",
];

// Fixed positions/delays for the floating background particles — deterministic
// so the markup doesn't shift between server and client renders.
const particles = [
  { top: "12%", left: "8%", size: 6, delay: "0s", dur: "7s" },
  { top: "22%", left: "18%", size: 4, delay: "1.2s", dur: "9s" },
  { top: "68%", left: "6%", size: 5, delay: "2.1s", dur: "8s" },
  { top: "78%", left: "16%", size: 3, delay: "0.6s", dur: "6.5s" },
  { top: "15%", right: "10%", size: 5, delay: "1.8s", dur: "8.5s" },
  { top: "35%", right: "5%", size: 4, delay: "0.3s", dur: "7.5s" },
  { top: "72%", right: "12%", size: 6, delay: "2.6s", dur: "9.5s" },
  { top: "88%", right: "22%", size: 3, delay: "1s", dur: "6s" },
];

// Deterministic candlestick heights so the decorative chart silhouette
// reads as real market data rather than random noise.
const candles = [22, 38, 16, 44, 28, 52, 20, 34, 46, 18, 30, 40];

// Fixed sparkle positions — small, fast twinkles distinct from the
// larger, slower-drifting glow particles above.
const sparkles = [
  { top: "18%", left: "28%", size: 3, delay: "0.4s" },
  { top: "62%", left: "34%", size: 2, delay: "1.6s" },
  { top: "30%", right: "30%", size: 2, delay: "0.9s" },
  { top: "70%", right: "26%", size: 3, delay: "2.2s" },
  { top: "48%", left: "3%", size: 2, delay: "1.1s" },
  { top: "50%", right: "3%", size: 2, delay: "1.9s" },
];
---

<section id="pricing" class="relative overflow-hidden bg-gradient-to-b from-[#eef4ff] via-[#f4f8ff] to-[#fbfdff] py-16 sm:py-24">
  <!-- ============ DECORATIVE BACKGROUND ============ -->
  <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
    <!-- soft blue-white base wash -->
    <div class="absolute inset-0 bg-[radial-gradient(120%_80%_at_50%_0%,rgba(59,130,246,0.08)_0%,rgba(255,255,255,0)_55%)]"></div>

    <!-- large blurred gradient blobs — soft blue top-left, small teal bottom-right -->
    <div class="pricing-blob absolute -top-24 -left-24 h-[28rem] w-[28rem] rounded-full bg-blue-400/20 blur-3xl [animation-duration:18s]"></div>
    <div class="pricing-blob absolute -bottom-16 -right-16 h-[16rem] w-[16rem] rounded-full bg-cyan-300/25 blur-3xl [animation-duration:14s] [animation-delay:-5s]"></div>

    <!-- radial glow directly behind the card row, pulsing gently -->
    <div class="pricing-glow-pulse absolute left-1/2 top-1/2 h-[30rem] w-[46rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(closest-side,rgba(37,99,235,0.09),rgba(6,182,212,0.06),transparent)] blur-2xl"></div>

    <!-- subtle sparkles -->
    {
      sparkles.slice(0, 3).map((s) => (
        <span
          class="pricing-sparkle absolute rounded-full bg-white shadow-[0_0_6px_2px_rgba(255,255,255,0.9)]"
          style={`top:${s.top}; ${s.left ? `left:${s.left};` : `right:${s.right};`} width:${s.size}px; height:${s.size}px; animation-delay:${s.delay};`}
        />
      ))
    }

    <!-- floating glow particles -->
    {
      particles.slice(0, 3).map((p) => (
        <span
          class="pricing-particle absolute rounded-full bg-blue-400/50 shadow-[0_0_10px_2px_rgba(59,130,246,0.35)]"
          style={`top:${p.top}; ${p.left ? `left:${p.left};` : `right:${p.right};`} width:${p.size}px; height:${p.size}px; animation-delay:${p.delay}; animation-duration:${p.dur};`}
        />
      ))
    }

    <!-- candlestick chart silhouette — left -->
    <svg
      class="absolute left-0 top-1/2 hidden h-64 w-40 -translate-y-1/2 opacity-[0.10] lg:block"
      viewBox="0 0 160 220"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      {
        candles.slice(0, 6).map((h, i) => (
          <g transform={`translate(${i * 26 + 6}, 0)`}>
            <line x1="8" y1={110 - h - 14} x2="8" y2={110 + h + 14} stroke="#0f172a" stroke-width="2" />
            <rect x="2" y={110 - h} width="12" height={h * 2} rx="2" fill={i % 2 === 0 ? "#059669" : "#1d4ed8"} />
          </g>
        ))
      }
    </svg>

    <!-- candlestick chart silhouette — right (mirrored) -->
    <svg
      class="absolute right-0 top-1/2 hidden h-64 w-40 -translate-y-1/2 scale-x-[-1] opacity-[0.10] lg:block"
      viewBox="0 0 160 220"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      {
        candles.slice(6, 12).map((h, i) => (
          <g transform={`translate(${i * 26 + 6}, 0)`}>
            <line x1="8" y1={110 - h - 14} x2="8" y2={110 + h + 14} stroke="#0f172a" stroke-width="2" />
            <rect x="2" y={110 - h} width="12" height={h * 2} rx="2" fill={i % 2 === 0 ? "#1d4ed8" : "#059669"} />
          </g>
        ))
      }
    </svg>
  </div>

  <div id="pricing-animate" class="relative z-10 mx-auto max-w-6xl translate-y-10 px-6 opacity-0 transition-all duration-700 ease-out">
    <div class="mx-auto max-w-5xl">
      <div class="text-center">
        <h2 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
          Choose Your Mentorship
        </h2>
        <p class="mt-3 text-base text-slate-500">
          Everything you need to become a confident and successful trader.
        </p>
      </div>

      <div class="mx-auto mt-6 flex max-w-md items-center justify-center gap-3">
        <span class="flex items-center gap-1.5 text-xs font-semibold text-slate-700">
          <span aria-hidden="true">👤</span> Your Journey
        </span>

        <span
          class="relative inline-flex h-5 w-9 flex-none items-center rounded-full bg-gradient-to-r from-blue-600 to-emerald-500 shadow-inner"
          role="img"
          aria-label="Toggle switched on"
        >
          <span class="inline-block h-4 w-4 translate-x-4 rounded-full bg-white shadow"></span>
        </span>

        <span class="flex items-center gap-1.5 text-xs font-semibold text-slate-700">
          <span aria-hidden="true">🏆</span> Successful Trader
        </span>
      </div>

      <!-- ============ CARD ROW — Free (new) + Premium (untouched) ============ -->
      <div class="relative mx-auto mt-24 flex max-w-4xl flex-col items-stretch justify-center gap-10 md:flex-row">
        <!-- glowing circular platform underneath both cards, pulsing slowly -->
        <div
          class="pricing-glow-pulse pointer-events-none absolute inset-x-0 -bottom-8 z-0 mx-auto h-20 w-3/4 max-w-xl rounded-full bg-gradient-to-r from-emerald-400/30 via-cyan-400/30 to-teal-400/30 blur-3xl"
          aria-hidden="true"
        ></div>

        <!-- FREE CARD — new -->
        <div class="w-full md:w-[22rem]">
          <div class="relative z-10 flex h-full flex-col overflow-hidden rounded-3xl border border-white/40 bg-white shadow-[0_25px_70px_-15px_rgba(16,185,129,0.35)]">
            <!-- glowing edge (static — animation removed to fix lag) -->
            <div class="pointer-events-none absolute -inset-1 -z-10 rounded-3xl bg-gradient-to-br from-emerald-300/50 to-cyan-300/50 blur-2xl" aria-hidden="true"></div>

            <!-- header wrapper — kept for spacing consistency, badge removed -->
            <div class="relative px-3 pb-3 pt-7">
              <!-- top block — gradient header with price, CTA; rounded on all four corners -->
              <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-emerald-600 via-teal-500 to-cyan-400 p-7 pt-8 text-white">
                <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-white/15 via-transparent to-black/10" aria-hidden="true"></div>

                <h3 class="relative text-xl font-bold text-white">Free Access</h3>
                <p class="relative mt-1 text-sm text-emerald-50">Perfect for getting started</p>

                <div class="relative mt-6 flex items-baseline gap-2">
                  <span class="text-5xl font-extrabold text-white">FREE</span>
                  <span class="text-sm font-medium text-emerald-50">$00 Fee</span>
                </div>

                <a
                  href="/free-registration"
                  class="group relative mt-6 flex items-center justify-center gap-2 rounded-full border-2 border-white/70 bg-white/95 px-6 py-3 text-center text-sm font-bold text-emerald-700 shadow-[0_12px_25px_-8px_rgba(0,0,0,0.25)] transition-all duration-300 hover:-translate-y-0.5 hover:scale-[1.03] hover:bg-white hover:shadow-[0_16px_38px_-8px_rgba(0,0,0,0.3)]"
                >
                  <span aria-hidden="true">🎁</span>
                  Get Started Free
                  <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m0 0-6-6m6 6-6 6" />
                  </svg>
                </a>
              </div>
            </div>

            <!-- middle block — white checklist, matching the reference layout -->
            <ul class="flex-1 space-y-4 px-7 pb-7">
              {
                freeFeatures.map((feature) => (
                  <li class="flex items-center gap-3 text-sm text-slate-700">
                    <span class="flex h-6 w-6 flex-none items-center justify-center rounded-full bg-emerald-100 text-emerald-600">
                      <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                        <path
                          fill-rule="evenodd"
                          d="M16.704 5.29a1 1 0 010 1.42l-7.5 7.5a1 1 0 01-1.42 0l-3.5-3.5a1 1 0 111.42-1.42L8.5 12.08l6.79-6.79a1 1 0 011.41 0z"
                          clip-rule="evenodd"
                        />
                      </svg>
                    </span>
                    {feature}
                  </li>
                ))
              }
            </ul>

            <!-- bottom footer strip -->
            <p class="flex items-center justify-center gap-2 rounded-b-3xl border-t border-emerald-100 bg-emerald-50/70 py-3 text-center text-xs font-semibold uppercase tracking-wide text-emerald-700">
              <span aria-hidden="true">🚀</span>
              Start Your Journey
            </p>
          </div>
        </div>

        <!-- PREMIUM CARD — unchanged, exactly as provided -->
        <div class="w-full md:w-[22rem]">
          <div class="relative z-10 flex flex-col rounded-3xl bg-gradient-to-br from-blue-600 to-emerald-500 p-7 text-white shadow-[0_25px_70px_-15px_rgba(5,150,105,0.5)]">
            <span class="absolute -top-3 left-8 rounded-full bg-white px-3 py-1 text-xs font-bold text-emerald-700">
              PRO
            </span>

            <h3 class="text-xl font-bold text-white">Premium</h3>
            <p class="mt-1 text-sm text-blue-50">Unlock Core Trading Concepts</p>

            <div class="mt-6 flex items-baseline gap-1">
              <span class="text-5xl font-extrabold text-white">$149</span>
              <span class="text-base font-medium text-blue-100">/2 Months</span>
            </div>

            <a
              href="/payment?plan=premium"
              class="mt-6 block rounded-full bg-white px-6 py-3 text-center text-sm font-bold text-emerald-700 shadow-[0_12px_25px_-8px_rgba(0,0,0,0.25)] transition-transform hover:-translate-y-0.5"
            >
              Join Premium Mentorship
            </a>

            <ul class="mt-8 flex-1 space-y-4">
              {
                premiumFeatures.map((feature) => (
                  <li class="flex items-center gap-3 text-sm text-blue-50">
                    <span class="flex h-6 w-6 flex-none items-center justify-center rounded-full bg-white/20 text-white">
                      <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                        <path
                          fill-rule="evenodd"
                          d="M16.704 5.29a1 1 0 010 1.42l-7.5 7.5a1 1 0 01-1.42 0l-3.5-3.5a1 1 0 111.42-1.42L8.5 12.08l6.79-6.79a1 1 0 011.41 0z"
                          clip-rule="evenodd"
                        />
                      </svg>
                    </span>
                    {feature}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Floating glow particles — gentle vertical drift + twinkle */
  .pricing-particle {
    animation-name: pricingParticleFloat;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }

  @keyframes pricingParticleFloat {
    0%, 100% {
      transform: translateY(0);
      opacity: 0.35;
    }
    50% {
      transform: translateY(-14px);
      opacity: 0.85;
    }
  }

  /* Slow, subtle animated light streaks */
  .pricing-streak {
    animation: pricingStreakShimmer 6s ease-in-out infinite;
  }

  @keyframes pricingStreakShimmer {
    0%, 100% {
      opacity: 0.15;
    }
    50% {
      opacity: 0.55;
    }
  }

  /* Background blobs — slow, wide drift so the atmosphere feels alive
     without ever reading as busy */
  .pricing-blob {
    animation-name: pricingBlobDrift;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }

  @keyframes pricingBlobDrift {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(2.5%, -3%) scale(1.06);
    }
  }

  /* Sparkles — quick, soft twinkle */
  .pricing-sparkle {
    animation: pricingSparkleTwinkle 2.4s ease-in-out infinite;
  }

  @keyframes pricingSparkleTwinkle {
    0%, 100% {
      opacity: 0;
      transform: scale(0.6);
    }
    50% {
      opacity: 1;
      transform: scale(1.2);
    }
  }

  /* Shared slow pulse for glows behind/around the cards */
  .pricing-glow-pulse {
    animation: pricingGlowPulse 5s ease-in-out infinite;
  }

  @keyframes pricingGlowPulse {
    0%, 100% {
      opacity: 0.7;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.04);
    }
  }

  /* Gentle idle float for the Free card only — the Premium card's own
     markup/classes are left untouched, so it stays exactly as designed */
  .pricing-card-float {
    animation: pricingCardFloat 6s ease-in-out infinite;
  }

  @keyframes pricingCardFloat {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pricing-particle,
    .pricing-streak,
    .pricing-blob,
    .pricing-sparkle,
    .pricing-glow-pulse,
    .pricing-card-float {
      animation: none !important;
    }
  }
</style>

<script>
  // Slide-up-and-fade-in animation the first time this section scrolls into view.
  const animatedEl = document.getElementById("pricing-animate");
  if (animatedEl) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animatedEl.classList.remove("translate-y-10", "opacity-0");
            animatedEl.classList.add("translate-y-0", "opacity-100");
          } else {
            animatedEl.classList.add("translate-y-10", "opacity-0");
            animatedEl.classList.remove("translate-y-0", "opacity-100");
          }
        });
      },
      { threshold: 0.2 }
    );
    observer.observe(animatedEl);
  }
</script>
