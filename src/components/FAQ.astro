---
const faqs = [
  {
    question: "Is This Mentorship For Beginners?",
    answer:
      "Yes. The Standard Mentorship is designed for beginners with little or no trading experience.",
  },
  {
    question: "How Will I Access The Mentorship?",
    answer:
      "Everything is managed through Telegram. No website login or password is required.",
  },
  {
    question: "How Can I Make A Payment?",
    answer:
      "We accept secure payments via bKash, Nagad, Rocket, Binance UID, Bybit UID, and USDT (TRC20/BEP20).",
  },
  {
    question: "What's The Difference Between Standard & Premium?",
    answer:
      "Premium includes everything in Standard, plus advanced market concepts, one-to-one support, live entry verification, and Prop Firm challenge guidance.",
  },
  {
    question: "Do You Guarantee Profits Or Offer Refunds?",
    answer:
      "No. Trading involves risk. We do not guarantee profits, payouts, or refunds after enrollment.",
  },
  {
    question: "Can I Share Or Record The Mentorship?",
    answer:
      "No. Sharing, recording, or redistributing any mentorship content is strictly prohibited.",
  },
  {
    question: "What If A Student Breaks The Rules?",
    answer:
      "Students are expected to maintain a respectful and professional learning environment. A warning will be issued for any disruptive or inappropriate behavior. Continued violations may result in permanent removal from the mentorship without prior notice. All enrollments are final, and no refund will be provided.",
  },
];
---

<section id="faq" class="bg-slate-50 py-20">
  <div id="faq-animate" class="mx-auto max-w-3xl translate-y-10 px-6 opacity-0 transition-all duration-700 ease-out">
    <div class="text-center">
      <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
        Frequently Asked Questions
      </h2>
    </div>

    <div class="mt-12 space-y-4">
      {
        faqs.map((faq) => (
          <details class="group rounded-xl border border-slate-200 bg-white p-6 open:border-blue-200">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-md font-semibold text-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700">
              {faq.question}
              <svg
                class="h-5 w-5 flex-none text-slate-400 transition-transform group-open:rotate-45"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M10 4a1 1 0 0 1 1 1v4h4a1 1 0 1 1 0 2h-4v4a1 1 0 1 1-2 0v-4H5a1 1 0 1 1 0-2h4V5a1 1 0 0 1 1-1Z" />
              </svg>
            </summary>
            <p class="mt-4 text-sm leading-relaxed text-slate-600">{faq.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Slide-up-and-fade-in animation the first time this section scrolls into view.
  const animatedEl = document.getElementById("faq-animate");
  if (animatedEl) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animatedEl.classList.remove("translate-y-10", "opacity-0");
            animatedEl.classList.add("translate-y-0", "opacity-100");
          } else {
            animatedEl.classList.add("translate-y-10", "opacity-0");
            animatedEl.classList.remove("translate-y-0", "opacity-100");
          }
        });
      },
      { threshold: 0.2 }
    );
    observer.observe(animatedEl);
  }
</script>
