---
// Free Registration Flow — completely separate from PaymentFlow.astro.
// Reuses the same layout, spacing, colors, typography, validation,
// animations, popup design, webhook logic, and Telegram integration as the
// Premium Payment Flow, but only collects information (no payment step).

---

<section class="relative overflow-hidden bg-slate-50 py-12">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 mx-auto h-72 w-72 rounded-full bg-gradient-to-br from-blue-300/30 to-emerald-300/30 blur-3xl"
  >
  </div>

  <div class="relative mx-auto max-w-2xl px-6">
    <h1 class="sr-only">MEXO TRADES Free Access Registration</h1>

    <!-- VIP eyebrow badge -->
    <div class="mb-6 flex justify-center">
      <span class="vip-badge">
        <span class="vip-badge-dot"></span>
        Free Access Pass · MEXO TRADES
      </span>
    </div>

    <!-- Progress indicator -->
    <div class="mb-10">
      <div class="stepper" aria-hidden="true">
        <div class="stepper-node" data-stepper-node="1">
          <span class="stepper-circle">1</span>
          <span class="stepper-label">Information</span>
        </div>
        <div class="stepper-line">
          <span id="free-progress-fill" class="stepper-line-fill" style="width: 50%"></span>
        </div>
        <div class="stepper-node" data-stepper-node="2">
          <span class="stepper-circle">2</span>
          <span class="stepper-label">Confirming</span>
        </div>
      </div>
      <div class="mt-4 flex items-center justify-between">
        <span id="free-progress-label" class="font-display text-xs font-bold uppercase tracking-[0.2em] text-slate-400">
          Step 1 of 2
        </span>
        <span id="free-progress-title" class="font-display text-sm font-bold text-slate-900">Your Information</span>
      </div>
    </div>


    <!-- STEP 1: Your Information -->
    <div data-free-step="1" class="glow-ring">
    <div class="page-card vip-card rounded-[2rem] p-6 sm:p-10">
      <a
        href="/"
        class="back-btn mb-6 inline-flex items-center gap-1.5 text-sm font-semibold text-slate-500 transition-colors hover:text-slate-900"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Back
      </a>

      <h2 class="font-display text-center text-2xl font-extrabold tracking-tight text-slate-900">Your Information</h2>
      <p class="mt-2 text-center text-sm text-slate-500">Tell us where to reach you.</p>

      <form id="free-info-form" class="mt-8 space-y-5">
        <div>
          <label class="flex items-center gap-1.5 text-sm font-semibold text-slate-700" for="free-fullName">
            <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="8" r="3.5" />
              <path stroke-linecap="round" d="M5 20c0-3.6 3.1-6.5 7-6.5s7 2.9 7 6.5" />
            </svg>
            Full Name
          </label>
          <div class="input-icon-wrap mt-1.5">
            <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="8" r="3.5" />
              <path stroke-linecap="round" d="M5 20c0-3.6 3.1-6.5 7-6.5s7 2.9 7 6.5" />
            </svg>
            <input
              id="free-fullName"
              name="fullName"
              type="text"
              required
              class="vip-input w-full rounded-2xl border border-slate-300 bg-white/90 py-3 pl-11 pr-4 text-sm text-slate-900 transition-all duration-200 focus:border-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-700"
            />
          </div>
          <p id="free-fullName-error" class="mt-1 hidden text-xs font-medium text-red-600">Please enter your full name.</p>
        </div>

        <div>
          <label class="flex items-center gap-1.5 text-sm font-semibold text-slate-700" for="free-email">
            <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2.5" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6.5l8 6 8-6" />
            </svg>
            Email Address
          </label>
          <div class="input-icon-wrap mt-1.5">
            <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2.5" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6.5l8 6 8-6" />
            </svg>
            <input
              id="free-email"
              name="email"
              type="email"
              required
              class="vip-input w-full rounded-2xl border border-slate-300 bg-white/90 py-3 pl-11 pr-4 text-sm text-slate-900 transition-all duration-200 focus:border-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-700"
            />
          </div>
          <p id="free-email-error" class="mt-1 hidden text-xs font-medium text-red-600">Please enter a valid email ending in @gmail.com (e.g. name@gmail.com).</p>
        </div>

        <div>
          <label class="flex items-center gap-1.5 text-sm font-semibold text-slate-700" for="free-phone">
            <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.5 3.5h3l1.5 4-2 1.5a11 11 0 006 6l1.5-2 4 1.5v3a2 2 0 01-2.2 2A17.5 17.5 0 014.5 5.7a2 2 0 012-2.2z" />
            </svg>
            Phone Number
          </label>
          <div class="input-icon-wrap mt-1.5">
            <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.5 3.5h3l1.5 4-2 1.5a11 11 0 006 6l1.5-2 4 1.5v3a2 2 0 01-2.2 2A17.5 17.5 0 014.5 5.7a2 2 0 012-2.2z" />
            </svg>
            <input
              id="free-phone"
              name="phone"
              type="tel"
              required
              class="vip-input w-full rounded-2xl border border-slate-300 bg-white/90 py-3 pl-11 pr-4 text-sm text-slate-900 transition-all duration-200 focus:border-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-700"
            />
          </div>
          <p id="free-phone-error" class="mt-1 hidden text-xs font-medium text-red-600">Phone number must be exactly 11 digits.</p>
        </div>

        <div>
          <label class="flex items-center gap-1.5 text-sm font-semibold text-slate-700" for="free-telegram">
            <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 4L3 11.5l6 2.2M21 4l-3.2 16-6.8-5M21 4L9.5 13.7l-.5 5.3 3.2-3.2" />
            </svg>
            Telegram Username
          </label>
          <div class="input-icon-wrap mt-1.5">
            <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 4L3 11.5l6 2.2M21 4l-3.2 16-6.8-5M21 4L9.5 13.7l-.5 5.3 3.2-3.2" />
            </svg>
            <input
              id="free-telegram"
              name="telegram"
              type="text"
              placeholder="@username"
              required
              class="vip-input w-full rounded-2xl border border-slate-300 bg-white/90 py-3 pl-11 pr-4 text-sm text-slate-900 transition-all duration-200 focus:border-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-700"
            />
          </div>
          <p id="free-telegram-error" class="mt-1 hidden text-xs font-medium text-red-600">Please enter your Telegram username.</p>
        </div>

        <div>
          <label class="flex items-center gap-1.5 text-sm font-semibold text-slate-700" for="free-country">
            <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="8.5" />
              <path stroke-linecap="round" d="M3.5 12h17M12 3.5c2.4 2.3 3.7 5.3 3.7 8.5s-1.3 6.2-3.7 8.5c-2.4-2.3-3.7-5.3-3.7-8.5S9.6 5.8 12 3.5z" />
            </svg>
            Country
          </label>
          <div class="input-icon-wrap mt-1.5">
            <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="8.5" />
              <path stroke-linecap="round" d="M3.5 12h17M12 3.5c2.4 2.3 3.7 5.3 3.7 8.5s-1.3 6.2-3.7 8.5c-2.4-2.3-3.7-5.3-3.7-8.5S9.6 5.8 12 3.5z" />
            </svg>
            <input
              id="free-country"
              name="country"
              type="text"
              required
              class="vip-input w-full rounded-2xl border border-slate-300 bg-white/90 py-3 pl-11 pr-4 text-sm text-slate-900 transition-all duration-200 focus:border-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-700"
            />
          </div>
          <p id="free-country-error" class="mt-1 hidden text-xs font-medium text-red-600">Please enter your country.</p>
        </div>

        <div>
          <label class="flex items-center gap-1.5 text-sm font-semibold text-slate-700" for="free-tradingExperience">
            <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 19V9m6.5 10V5M17 19v-6" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 19h16" />
            </svg>
            Trading Experience
          </label>
          <div class="input-icon-wrap mt-1.5">
            <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 19V9m6.5 10V5M17 19v-6" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 19h16" />
            </svg>
            <select
              id="free-tradingExperience"
              name="tradingExperience"
              required
              class="vip-input w-full rounded-2xl border border-slate-300 bg-white/90 py-3 pl-11 pr-4 text-sm text-slate-900 transition-all duration-200 focus:border-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-700"
            >
              <option value="" disabled selected>Select Your Trading Experience</option>
              <option value="I'm Completely New">I'm Completely New</option>
              <option value="0–6 Months">0–6 Months</option>
              <option value="6 Months–2 Years">6 Months–2 Years</option>
              <option value="2–5 Years">2–5 Years</option>
              <option value="5+ Years">5+ Years</option>
            </select>
          </div>
          <p id="free-tradingExperience-error" class="mt-1 hidden text-xs font-medium text-red-600">Please select your trading experience.</p>
        </div>

        <label class="flex items-start gap-3 rounded-2xl border border-slate-200 bg-slate-50/70 p-4 pt-4 text-sm text-slate-700">
          <input
            id="free-confirm-correct"
            type="checkbox"
            class="mt-0.5 h-4 w-4 rounded border-slate-300 text-blue-700 focus:ring-blue-700"
          />
          I confirm all the information provided is correct.
        </label>

        <button
          type="button"
          id="free-to-step-2"
          disabled
          aria-disabled="true"
          class="shine-btn w-full rounded-full bg-gradient-to-r from-blue-600 to-emerald-500 px-6 py-3.5 text-sm font-bold text-white opacity-30 shadow-[0_12px_25px_-8px_rgba(29,78,216,0.5)] transition-all duration-300 pointer-events-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700"
        >
          <span class="relative z-10">Continue</span>
        </button>
      </form>
    </div>
    </div>

    <!-- STEP 2: Confirming Registration -->
    <div data-free-step="2" class="glow-ring hidden">
    <div class="page-card vip-card rounded-[2rem] p-6 sm:p-10">
      <button
        type="button"
        class="back-btn mb-6 inline-flex items-center gap-1.5 text-sm font-semibold text-slate-500 transition-colors hover:text-slate-900"
        data-free-back-to="1"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Back
      </button>

      <span class="vip-badge vip-badge--sm mx-auto mb-3 flex w-fit items-center">
        <span class="vip-badge-dot"></span>
        Almost There
      </span>
      <h2 class="font-display text-center text-2xl font-extrabold tracking-tight text-slate-900">Confirming Registration</h2>
      <p class="mt-2 text-center text-sm text-slate-500">Please wait while we check your registration details.</p>

      <div id="free-checking-box" class="mt-8 flex flex-col items-center gap-4 rounded-2xl border border-slate-200 bg-gradient-to-br from-slate-50 to-white p-8 transition-colors duration-300">
        <div id="free-checking-spinner" class="mini-spinner" aria-hidden="true"></div>
        <span id="free-checking-icon" class="hidden text-3xl leading-none" aria-hidden="true"></span>
        <p id="free-checking-status" class="font-display text-sm font-bold text-slate-700">Checking Registration Details…</p>
        <p id="free-checking-countdown" class="font-display text-4xl font-extrabold text-blue-700">30s</p>
      </div>

      <p id="free-send-error" class="mt-3 hidden text-center text-xs font-semibold text-red-600"></p>

      <button
        type="button"
        id="free-send-now-btn"
        disabled
        aria-disabled="true"
        class="send-now-btn shine-btn mt-8 w-full rounded-full bg-gradient-to-r from-blue-600 to-emerald-500 px-6 py-3.5 text-sm font-bold text-white opacity-30 shadow-[0_12px_25px_-8px_rgba(29,78,216,0.5)] transition-all duration-300 pointer-events-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700"
      >
        <span class="relative z-10 inline-flex items-center justify-center gap-1.5">
          <span id="free-send-now-label">Please Wait…</span>
          <svg id="free-send-now-arrow" class="nudge-arrow hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m0 0l-6-6m6 6l-6 6" />
          </svg>
        </span>
      </button>
    </div>
    </div>
  </div>
</section>

<!-- Free Registration Success Popup — same component/design as the Payment flow's popup, content only changed -->
<div id="free-success-popup-overlay" class="success-popup-overlay hidden" role="dialog" aria-modal="true" aria-labelledby="free-success-popup-title">
  <div id="free-success-popup-card" class="success-popup-card vip-popup-card">
    <span class="popup-sparkle popup-sparkle--1" aria-hidden="true">✦</span>
    <span class="popup-sparkle popup-sparkle--2" aria-hidden="true">✦</span>
    <span class="popup-sparkle popup-sparkle--3" aria-hidden="true">✦</span>

    <span class="vip-badge vip-badge--sm mx-auto mb-4 flex w-fit items-center">
      <span class="vip-badge-dot"></span>
      Welcome to MEXO
    </span>

    <div class="success-icon-wrap">
      <svg class="success-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path class="success-icon-check" stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <h3 id="free-success-popup-title" class="font-display mt-6 text-center text-xl font-extrabold tracking-tight text-slate-900">
      Registration Submitted Successfully
    </h3>
    <p class="mx-auto mt-3 max-w-sm text-center text-sm leading-relaxed text-slate-600">
      Your Free Access registration has been submitted successfully. Our team will review your information and contact you soon via Telegram or Email.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a
        href="https://t.me/+OWIkFa_9tPlkMWQ1"
        target="_blank"
        rel="noopener noreferrer"
        class="shine-btn flex-1 rounded-full bg-gradient-to-r from-blue-600 to-emerald-500 px-6 py-3 text-center text-sm font-bold text-white shadow-[0_12px_25px_-8px_rgba(29,78,216,0.5)] transition-transform hover:-translate-y-0.5"
      >
        <span class="relative z-10 inline-flex items-center justify-center gap-2">
          Join Classroom
          <svg class="join-arrow h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m0 0l-6-6m6 6l-6 6" />
          </svg>
        </span>
      </a>
    </div>
  </div>
</div>

<!-- Phone verification: brief "checking" overlay before the confirm modal.
     Purely a frontend re-confirmation / anti-spam step — no SMS or
     third-party phone verification happens here. -->
<div id="free-phone-checking-overlay" class="confirm-overlay hidden" role="dialog" aria-modal="true" aria-labelledby="free-phone-checking-title">
  <div class="confirm-card vip-popup-card">
    <span class="popup-sparkle popup-sparkle--1" aria-hidden="true">✦</span>
    <span class="popup-sparkle popup-sparkle--2" aria-hidden="true">✦</span>
    <div class="mini-spinner" aria-hidden="true"></div>
    <h3 id="free-phone-checking-title" class="font-display mt-4 text-center text-lg font-extrabold tracking-tight text-slate-900">
      Verifying Your Phone Number
    </h3>
    <p class="mt-2 text-center text-sm text-slate-500">Please wait while we verify your registration details.</p>
  </div>
</div>

<!-- Phone confirmation modal (registration re-confirmation, not real SMS/authentication) -->
<div id="free-confirm-phone-overlay" class="confirm-overlay hidden" role="dialog" aria-modal="true" aria-labelledby="free-confirm-phone-title">
  <div class="confirm-card vip-popup-card">
    <span class="popup-sparkle popup-sparkle--1" aria-hidden="true">✦</span>
    <span class="popup-sparkle popup-sparkle--2" aria-hidden="true">✦</span>
    <span class="popup-sparkle popup-sparkle--3" aria-hidden="true">✦</span>

    <!-- Phase 1: result after checking -->
    <div id="free-confirm-phase-result" class="text-center">
      <div class="warning-icon-wrap" aria-hidden="true">
        <span class="warning-icon-emoji">⚠️</span>
      </div>
      <span class="vip-badge vip-badge--sm mx-auto mt-4 mb-1 flex w-fit items-center">
        <span class="vip-badge-dot"></span>
        Verification Needed
      </span>
      <h3 id="free-confirm-phone-title" class="font-display mt-2 text-center text-lg font-extrabold tracking-tight text-slate-900">
        Phone Confirmation Required
      </h3>
      <p class="mt-2 text-center text-sm text-slate-500">
        We couldn't confirm your registration details automatically. Please confirm the phone number you
        entered, or edit your information if something's incorrect.
      </p>
      <div class="mt-6 flex flex-col gap-2.5">
        <button
          type="button"
          id="free-confirm-phone-btn"
          class="shine-btn w-full rounded-full bg-gradient-to-r from-blue-600 to-emerald-500 px-6 py-3 text-sm font-bold text-white shadow-[0_12px_25px_-8px_rgba(29,78,216,0.5)] transition-transform hover:-translate-y-0.5"
        >
          <span class="relative z-10">Confirm Phone Number</span>
        </button>
        <button
          type="button"
          id="free-confirm-phone-edit-btn"
          class="w-full rounded-full border border-slate-300 bg-white px-6 py-3 text-sm font-bold text-slate-700 transition-colors hover:bg-slate-50"
        >
          Edit Information
        </button>
      </div>
    </div>

    <!-- Phase 2: re-enter phone number -->
    <div id="free-confirm-phase-input" class="hidden">
      <div class="mobile-icon-wrap" aria-hidden="true">
        <span class="mobile-icon-emoji">📱</span>
      </div>
      <h3 class="font-display mt-4 text-center text-lg font-extrabold tracking-tight text-slate-900">Confirm Your Phone Number</h3>
      <p class="mt-2 text-center text-sm text-slate-500">Enter the phone number you provided during registration.</p>
      <div class="mt-5">
        <label class="flex items-center gap-1.5 text-sm font-semibold text-slate-700" for="free-confirm-phone-input">
          <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.5 3.5h3l1.5 4-2 1.5a11 11 0 006 6l1.5-2 4 1.5v3a2 2 0 01-2.2 2A17.5 17.5 0 014.5 5.7a2 2 0 012-2.2z" />
          </svg>
          Confirm the phone number you entered
        </label>
        <div class="input-icon-wrap mt-1.5">
          <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.5 3.5h3l1.5 4-2 1.5a11 11 0 006 6l1.5-2 4 1.5v3a2 2 0 01-2.2 2A17.5 17.5 0 014.5 5.7a2 2 0 012-2.2z" />
          </svg>
          <input
            id="free-confirm-phone-input"
            type="tel"
            inputmode="numeric"
            maxlength="11"
            placeholder="Fill your valid number"
            class="vip-input w-full rounded-2xl border border-slate-300 bg-white/90 py-3 pl-11 pr-4 text-sm text-slate-900 transition-all duration-200 focus:border-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-700"
          />
        </div>
        <p id="free-confirm-phone-error" class="mt-1.5 hidden text-xs font-medium text-red-600">Phone Number Does Not Match.</p>
      </div>
      <div class="mt-6">
        <button
          type="button"
          id="free-confirm-phone-submit-btn"
          class="shine-btn w-full rounded-full bg-gradient-to-r from-blue-600 to-emerald-500 px-6 py-3 text-sm font-bold text-white shadow-[0_12px_25px_-8px_rgba(29,78,216,0.5)] transition-transform hover:-translate-y-0.5"
        >
          <span class="relative z-10">Confirm</span>
        </button>
      </div>
    </div>

    <!-- Phase 2.5: 10s verifying loading, shown after Confirm is clicked and the
         number matches, before the success phase appears -->
    <div id="free-confirm-phase-loading" class="hidden text-center">
      <div class="mini-spinner" aria-hidden="true"></div>
      <h3 class="font-display mt-4 text-center text-lg font-extrabold tracking-tight text-slate-900">Verifying…</h3>
      <p class="mt-2 text-center text-sm text-slate-500">Please wait while we finalize your phone confirmation.</p>
    </div>

    <!-- Phase 3: success -->
    <div id="free-confirm-phase-success" class="hidden text-center">
      <div id="free-confirm-success-icon-wrap" class="success-icon-wrap" style="height:3.25rem;width:3.25rem;">
        <svg class="success-icon" style="height:1.5rem;width:1.5rem;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path class="success-icon-check" stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <span class="vip-badge vip-badge--sm mx-auto mt-4 mb-1 flex w-fit items-center">
        <span class="vip-badge-dot"></span>
        Verified
      </span>
      <h3 class="font-display mt-2 text-lg font-extrabold tracking-tight text-slate-900">Registration Phone Confirmed</h3>
      <p class="mt-2 text-sm text-slate-500">
        This confirms that the phone number entered matches your registration details.
      </p>
      <div class="mt-6">
        <button
          type="button"
          id="free-confirm-phone-next-btn"
          class="shine-btn w-full rounded-full bg-gradient-to-r from-blue-600 to-emerald-500 px-6 py-3 text-sm font-bold text-white shadow-[0_12px_25px_-8px_rgba(29,78,216,0.5)] transition-transform hover:-translate-y-0.5"
        >
          <span class="relative z-10">Next</span>
        </button>
      </div>
    </div>

  </div>
</div>

<style>
  /* ---------------------------------------------------------------------
     VIP visual layer — display font + dark aurora scene + premium card
     chrome. Purely presentational: no ids used by the script below are
     touched, and no field/validation classes are removed.
  --------------------------------------------------------------------- */
  @import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap");

  .font-display {
