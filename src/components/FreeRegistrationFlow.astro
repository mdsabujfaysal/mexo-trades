    background: linear-gradient(135deg, rgba(16, 185, 129, 0.7), rgba(37, 99, 235, 0.5), rgba(16, 185, 129, 0.35));
    box-shadow: 0 20px 50px -20px rgba(15, 23, 42, 0.25), 0 0 30px -14px rgba(16, 185, 129, 0.4);
  }
  .glow-ring.hidden {
    display: none;
  }

  .vip-card {
    border: 1px solid rgba(255, 255, 255, 0.6);
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: blur(20px);
  }

  /* Stylish stepper (purely visual — #free-progress-fill keeps its id and
     inline width so the existing script logic is unaffected) */
  .stepper {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .stepper-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }
  .stepper-circle {
    display: flex;
    height: 2rem;
    width: 2rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    font-family: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
    font-weight: 700;
    font-size: 0.8rem;
    color: white;
    background: linear-gradient(135deg, #10b981, #2563eb);
    box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.12), 0 8px 20px -8px rgba(16, 185, 129, 0.7);
  }
  .stepper-label {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: rgba(100, 116, 139, 0.85);
  }
  .stepper-line {
    position: relative;
    top: -0.9rem;
    flex: 1;
    height: 4px;
    overflow: hidden;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.12);
  }
  .stepper-line-fill {
    display: block;
    height: 100%;
    border-radius: 9999px;
    background: linear-gradient(90deg, #10b981, #2563eb);
    box-shadow: 0 0 10px 1px rgba(16, 185, 129, 0.7);
    transition: width 0.5s ease-out;
  }

  /* Shine sweep on primary buttons */
  .shine-btn {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .shine-btn::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(115deg, transparent 20%, rgba(255, 255, 255, 0.45) 40%, transparent 60%);
    transform: translateX(-120%);
  }
  .shine-btn:not(:disabled):hover::before {
    animation: shine-sweep 1.1s ease;
  }

  /* Nudging arrow on the Join Classroom button — draws the eye to click */
  .join-arrow {
    animation: nudge-arrow 1.2s ease-in-out infinite;
  }
  @keyframes nudge-arrow {
    0%,
    100% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(5px);
    }
  }
  @keyframes shine-sweep {
    to {
      transform: translateX(120%);
    }
  }

  .vip-input:focus {
    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12), 0 8px 20px -10px rgba(16, 185, 129, 0.4);
  }

  .vip-popup-card {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(16, 185, 129, 0.18);
  }
  .popup-sparkle {
    position: absolute;
    color: #34d399;
    opacity: 0.6;
    font-size: 0.85rem;
    animation: twinkle 2.6s ease-in-out infinite;
  }
  .popup-sparkle--1 { top: 1.25rem; left: 1.5rem; animation-delay: 0.1s; }
  .popup-sparkle--2 { top: 2rem; right: 2rem; color: #2563eb; animation-delay: 0.7s; }
  .popup-sparkle--3 { bottom: 1.5rem; left: 2.25rem; animation-delay: 1.3s; }

  @media (prefers-reduced-motion: reduce) {
    .vip-badge-dot,
    .popup-sparkle,
    .shine-btn::before {
      animation: none !important;
    }
  }

  /* Same page-in animation used by the Payment flow's .page-card */
  .page-card {
    animation: page-in 0.4s ease-out;
  }
  @keyframes page-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .send-now-btn {
    position: relative;
    overflow: hidden;
  }
  .send-now-btn:not(:disabled):hover {
    filter: brightness(1.05);
    transform: translateY(-1px);
  }

  /* Success popup — identical styling contract to PaymentFlow.astro's popup
     (#success-popup-overlay / #success-popup-card), duplicated here because
     Astro scopes styles per-component and the Payment flow's <style> block
     was left untouched. Class names match so any future shared popup
     component can be swapped in without visual changes. */
  .success-popup-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: rgba(15, 23, 42, 0.55);
    backdrop-filter: blur(4px);
  }
  .success-popup-overlay.hidden {
    display: none;
  }
  .success-popup-card {
    width: 100%;
    max-width: 26rem;
    border-radius: 1.75rem;
    background: white;
    padding: 2.5rem 2rem;
    box-shadow: 0 30px 80px -20px rgba(15, 23, 42, 0.45);
    animation: popup-in 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes popup-in {
    from {
      opacity: 0;
      transform: scale(0.94) translateY(8px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }
  .success-icon-wrap {
    margin: 0 auto;
    display: flex;
    height: 4rem;
    width: 4rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: linear-gradient(to bottom right, #2563eb, #10b981);
    box-shadow: 0 12px 30px -10px rgba(16, 185, 129, 0.5);
  }
  .success-icon {
    height: 2rem;
    width: 2rem;
    color: white;
  }

  /* Checking overlay + phone confirmation modal — same overlay/card pattern
     as the success popup above, simple and unstyled beyond that. */
  .confirm-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: rgba(15, 23, 42, 0.55);
    backdrop-filter: blur(4px);
  }
  .confirm-overlay.hidden {
    display: none;
  }
  .confirm-card {
    width: 100%;
    max-width: 24rem;
    border-radius: 1.5rem;
    background: white;
    padding: 2rem 1.75rem;
    box-shadow: 0 30px 80px -20px rgba(15, 23, 42, 0.45);
    animation: popup-in 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .mini-spinner {
    margin: 0 auto;
    height: 2.5rem;
    width: 2.5rem;
    border-radius: 9999px;
    border: 3px solid rgba(37, 99, 235, 0.2);
    border-top-color: #2563eb;
    animation: mini-spin 0.8s linear infinite;
  }
  @keyframes mini-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .warning-icon-wrap {
    margin: 0 auto;
    display: flex;
    height: 3.25rem;
    width: 3.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: rgba(245, 158, 11, 0.12);
  }
  .warning-icon-emoji {
    font-size: 1.5rem;
    line-height: 1;
  }
  .mobile-icon-wrap {
    margin: 0 auto;
    display: flex;
    height: 3.25rem;
    width: 3.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: rgba(37, 99, 235, 0.1);
  }
  .mobile-icon-emoji {
    font-size: 1.5rem;
    line-height: 1;
  }

  /* Nudge arrow on the "Confirm Registration" button — gently bounces
     side to side to draw the eye toward the action. */
  .nudge-arrow {
    animation: nudge-arrow 1.1s ease-in-out infinite;
  }
  @keyframes nudge-arrow {
    0%,
    100% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(5px);
    }
  }

  /* Tick pop-in animation, played once the phone number is verified. */
  .tick-pop {
    animation: tick-pop 480ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  @keyframes tick-pop {
    0% {
      transform: scale(0.3);
      opacity: 0;
    }
    60% {
      transform: scale(1.15);
      opacity: 1;
    }
    100% {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>

<script>
  import {
    isValidEmail,
    isValidPhone,
    isNonEmpty,
  } from "../lib/mexoSubmission";

  // New submission target: a Google Apps Script Web App that writes the
  // registration to a Google Sheet and forwards it to Discord on the
  // backend. The frontend no longer talks to Telegram or Discord directly,
  // and no webhook/token is exposed here.
  const FREE_REGISTRATION_API_URL =
    "https://script.google.com/macros/s/AKfycbziS6kTlVEkZX8y5WomhPG91q8hlcaRZ9O3rr2D4GhxTG9i_if23IIOpspBeJp8e2ozww/exec";

  let currentFreeStep = 1;
  const FREE_STEP_TITLES: Record<number, string> = {
    1: "Your Information",
    2: "Confirming Registration",
  };

  const freeStepDivs = document.querySelectorAll<HTMLDivElement>("[data-free-step]");
  const freeProgressFill = document.getElementById("free-progress-fill") as HTMLDivElement;
  const freeProgressLabel = document.getElementById("free-progress-label") as HTMLSpanElement;
  const freeProgressTitle = document.getElementById("free-progress-title") as HTMLSpanElement;

  function goToFreeStep(step: number) {
    currentFreeStep = step;
    freeStepDivs.forEach((div) => {
      div.classList.toggle("hidden", div.dataset.freeStep !== String(step));
    });
    freeProgressFill.style.width = `${(step / 2) * 100}%`;
    freeProgressLabel.textContent = `Step ${step} of 2`;
    freeProgressTitle.textContent = FREE_STEP_TITLES[step];
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  document.querySelectorAll<HTMLButtonElement>("[data-free-back-to]").forEach((btn) => {
    btn.addEventListener("click", () => goToFreeStep(Number(btn.dataset.freeBackTo)));
  });

  /* ---------------------------------------------------------------------
     STEP 1: Your Information (same validation rules as the Payment flow)
  --------------------------------------------------------------------- */
  const confirmCorrect = document.getElementById("free-confirm-correct") as HTMLInputElement;
  const toStep2Btn = document.getElementById("free-to-step-2") as HTMLButtonElement;

  const fullNameInput = document.getElementById("free-fullName") as HTMLInputElement;
  const emailInput = document.getElementById("free-email") as HTMLInputElement;
  const phoneInput = document.getElementById("free-phone") as HTMLInputElement;
  const telegramInput = document.getElementById("free-telegram") as HTMLInputElement;
  const countryInput = document.getElementById("free-country") as HTMLInputElement;
  const tradingExperienceInput = document.getElementById("free-tradingExperience") as HTMLSelectElement;

  const infoFields = [
    { input: fullNameInput, errorId: "free-fullName-error", isValid: isNonEmpty },
    { input: emailInput, errorId: "free-email-error", isValid: isValidEmail },
    { input: phoneInput, errorId: "free-phone-error", isValid: isValidPhone },
    { input: telegramInput, errorId: "free-telegram-error", isValid: isNonEmpty },
    { input: countryInput, errorId: "free-country-error", isValid: isNonEmpty },
    { input: tradingExperienceInput, errorId: "free-tradingExperience-error", isValid: isNonEmpty },
  ];

  const setFieldError = (input: HTMLInputElement, errorId: string, hasError: boolean) => {
    const errorEl = document.getElementById(errorId);
    input.classList.toggle("border-red-500", hasError);
    input.classList.toggle("focus:border-red-500", hasError);
    input.classList.toggle("focus:ring-red-500", hasError);
    input.classList.toggle("border-slate-300", !hasError);
    input.classList.toggle("focus:border-blue-700", !hasError);
    input.classList.toggle("focus:ring-blue-700", !hasError);
    errorEl?.classList.toggle("hidden", !hasError);
  };

  const validateAllFields = (showErrors: boolean) => {
    let allValid = true;
    infoFields.forEach(({ input, errorId, isValid }) => {
      const valid = isValid(input.value);
      if (!valid) allValid = false;
      if (showErrors) setFieldError(input, errorId, !valid);
    });
    return allValid;
  };

  const setContinueEnabled = (enabled: boolean) => {
    toStep2Btn.disabled = !enabled;
    toStep2Btn.setAttribute("aria-disabled", String(!enabled));
    toStep2Btn.classList.toggle("opacity-30", !enabled);
    toStep2Btn.classList.toggle("pointer-events-none", !enabled);
  };

  infoFields.forEach(({ input, errorId }) => {
    const revalidate = () => {
      if (confirmCorrect.checked) {
        const allValid = validateAllFields(true);
        setContinueEnabled(allValid);
      } else {
        setFieldError(input, errorId, false);
      }
    };
    input.addEventListener("input", revalidate);
    input.addEventListener("change", revalidate);
  });

  confirmCorrect.addEventListener("change", () => {
    if (confirmCorrect.checked) {
      const allValid = validateAllFields(true);
      setContinueEnabled(allValid);
    } else {
      setContinueEnabled(false);
    }
  });

  type FreeRegistrationData = {
    fullName: string;
    email: string;
    phone: string;
    telegram: string;
    country: string;
    tradingExperience: string;
  };

  let registrationData: FreeRegistrationData | null = null;

  toStep2Btn.addEventListener("click", () => {
    if (toStep2Btn.disabled) return;

    registrationData = {
      fullName: fullNameInput.value.trim(),
      email: emailInput.value.trim(),
      phone: phoneInput.value.trim(),
      telegram: telegramInput.value.trim(),
      country: countryInput.value.trim(),
      tradingExperience: tradingExperienceInput.value,
    };

    // Any (re)entry into Step 2 — first pass or after editing — requires
    // the phone number to be (re)confirmed before final submission.
    phoneConfirmed = false;
    confirmationInProgress = false;
    if (phoneCheckingTimer !== undefined) {
      window.clearTimeout(phoneCheckingTimer);
      phoneCheckingTimer = undefined;
    }
    hidePhoneCheckingOverlay();
    closeConfirmPhoneModal();

    goToFreeStep(2);
    startCheckingCountdown();
  });

  /* ---------------------------------------------------------------------
     STEP 2: 20s checking countdown, then Send Information Now
  --------------------------------------------------------------------- */
  const sendNowBtn = document.getElementById("free-send-now-btn") as HTMLButtonElement;
  const sendNowLabel = document.getElementById("free-send-now-label") as HTMLSpanElement;
  const sendErrorEl = document.getElementById("free-send-error") as HTMLParagraphElement;
  const successPopupOverlay = document.getElementById("free-success-popup-overlay") as HTMLDivElement;

  const checkingBox = document.getElementById("free-checking-box") as HTMLDivElement;
  const checkingIcon = document.getElementById("free-checking-icon") as HTMLSpanElement;
  const checkingSpinner = document.getElementById("free-checking-spinner") as HTMLDivElement;
  const checkingStatusEl = document.getElementById("free-checking-status") as HTMLParagraphElement;
  const checkingCountdownEl = document.getElementById("free-checking-countdown") as HTMLParagraphElement;
  const sendNowArrow = document.getElementById("free-send-now-arrow") as unknown as HTMLElement;

  const CHECKING_COUNTDOWN_SECONDS = 30;
  let checkingInterval: number | undefined;

  // Tracks what the Send/Verify/Confirm button should say and look like
  // while it's NOT in its transient "sending" state.
  let sendBtnRestLabel = "Please Wait…";
  let sendBtnArrowVisible = false;

  function setSendBtnEnabled(enabled: boolean) {
    sendNowBtn.disabled = !enabled;
    sendNowBtn.setAttribute("aria-disabled", String(!enabled));
    sendNowBtn.classList.toggle("opacity-30", !enabled);
    sendNowBtn.classList.toggle("pointer-events-none", !enabled);
  }

  // Swaps the checking box between its three visual states: the neutral
  // "checking" look, a light-red "error" look once the 30s check finishes,
  // and a light-green "verified" look once the phone number is confirmed.
  function setCheckingBoxState(state: "checking" | "error" | "verified") {
    checkingBox.classList.remove(
      "border-slate-200",
      "bg-gradient-to-br",
      "from-slate-50",
      "to-white",
      "border-red-300",
      "bg-red-50",
      "border-emerald-300",
      "bg-emerald-50"
    );
    checkingStatusEl.classList.remove("text-slate-700", "text-red-600", "text-emerald-700", "text-blue-700");

    if (state === "checking") {
      checkingBox.classList.add("border-slate-200", "bg-gradient-to-br", "from-slate-50", "to-white");
      checkingStatusEl.classList.add("text-slate-700");
      checkingIcon.classList.add("hidden");
    } else if (state === "error") {
      checkingBox.classList.add("border-red-300", "bg-red-50");
      checkingStatusEl.classList.add("text-red-600");
      checkingIcon.textContent = "⚠️";
      checkingIcon.classList.remove("hidden");
    } else {
      checkingBox.classList.add("border-emerald-300", "bg-emerald-50");
      checkingStatusEl.classList.add("text-emerald-700");
      checkingIcon.textContent = "✅";
      checkingIcon.classList.remove("hidden");
    }
  }

  // Runs a 30 second countdown showing a "checking" status. Purely a
  // frontend pacing step (no verification happens) — once it reaches 0 the
  // box flips to an error state and the Verify Now button is enabled so
  // the user can proceed to confirm their phone number.
  function startCheckingCountdown() {
    if (checkingInterval !== undefined) {
      window.clearInterval(checkingInterval);
      checkingInterval = undefined;
    }

    let remaining = CHECKING_COUNTDOWN_SECONDS;
    checkingSpinner.classList.remove("hidden");
    setCheckingBoxState("checking");
    checkingStatusEl.textContent = "Checking Registration Details…";
    checkingCountdownEl.textContent = `${remaining}s`;
    sendBtnRestLabel = "Please Wait…";
    sendBtnArrowVisible = false;
    setSendBtnEnabled(false);
    setSendingState(false);

    checkingInterval = window.setInterval(() => {
      remaining -= 1;
      if (remaining <= 0) {
        window.clearInterval(checkingInterval);
        checkingInterval = undefined;
        checkingSpinner.classList.add("hidden");
        setCheckingBoxState("error");
        checkingStatusEl.textContent = "Detail Check Error";
        checkingCountdownEl.textContent = "";
        sendBtnRestLabel = "Verify Now";
        sendBtnArrowVisible = false;
        setSendBtnEnabled(true);
        setSendingState(false);
      } else {
        checkingCountdownEl.textContent = `${remaining}s`;
      }
    }, 1000);
  }

  function stopCheckingCountdown() {
    if (checkingInterval !== undefined) {
      window.clearInterval(checkingInterval);
      checkingInterval = undefined;
    }
  }

  document.querySelectorAll<HTMLButtonElement>("[data-free-back-to]").forEach((btn) => {
    btn.addEventListener("click", () => {
      stopCheckingCountdown();
      confirmationInProgress = false;
      if (phoneCheckingTimer !== undefined) {
        window.clearTimeout(phoneCheckingTimer);
        phoneCheckingTimer = undefined;
      }
      hidePhoneCheckingOverlay();
      closeConfirmPhoneModal();
    });
  });

  function openSuccessPopup() {
    successPopupOverlay.classList.remove("hidden");
  }

  function setSendingState(sending: boolean) {
    sendNowBtn.disabled = sending;
    sendNowBtn.classList.toggle("pointer-events-none", sending);
    if (sending) {
      sendNowLabel.innerHTML = 'Sending... <span class="spin-emoji">♻️</span>';
      sendNowArrow.classList.add("hidden");
    } else {
      sendNowLabel.textContent = sendBtnRestLabel;
      sendNowArrow.classList.toggle("hidden", !sendBtnArrowVisible);
    }
  }

  function showSendError(message: string) {
    sendErrorEl.textContent = message;
    sendErrorEl.classList.remove("hidden");
  }

  function clearSendError() {
    sendErrorEl.classList.add("hidden");
  }

  /* ---------------------------------------------------------------------
     Phone verification (registration re-confirmation + anti-spam friction,
     NOT real SMS or third-party phone authentication). The user simply
     re-enters the phone number from their registration and it is compared
     to registrationData.phone on the frontend. This gates the actual
     "Send Information Now" submission below.
  --------------------------------------------------------------------- */
  let phoneConfirmed = false;
  let confirmationAttemptCount = 0;
  let confirmationInProgress = false;
  let phoneCheckingTimer: number | undefined;
  let confirmVerifyingTimer: number | undefined;

  const PHONE_CHECKING_DELAY_MS = 2500;
  const CONFIRM_VERIFYING_DELAY_MS = 10000;

  const phoneCheckingOverlay = document.getElementById("free-phone-checking-overlay") as HTMLDivElement;
  const confirmPhoneOverlay = document.getElementById("free-confirm-phone-overlay") as HTMLDivElement;
  const confirmPhaseResult = document.getElementById("free-confirm-phase-result") as HTMLDivElement;
  const confirmPhaseInput = document.getElementById("free-confirm-phase-input") as HTMLDivElement;
  const confirmPhaseLoading = document.getElementById("free-confirm-phase-loading") as HTMLDivElement;
  const confirmPhaseSuccess = document.getElementById("free-confirm-phase-success") as HTMLDivElement;
  const confirmSuccessIconWrap = document.getElementById("free-confirm-success-icon-wrap") as HTMLDivElement;
  const confirmEditBtn = document.getElementById("free-confirm-phone-edit-btn") as HTMLButtonElement;
  const confirmOpenInputBtn = document.getElementById("free-confirm-phone-btn") as HTMLButtonElement;
  const confirmSubmitBtn = document.getElementById("free-confirm-phone-submit-btn") as HTMLButtonElement;
  const confirmNextBtn = document.getElementById("free-confirm-phone-next-btn") as HTMLButtonElement;
  const confirmPhoneInput = document.getElementById("free-confirm-phone-input") as HTMLInputElement;
  const confirmPhoneError = document.getElementById("free-confirm-phone-error") as HTMLParagraphElement;

  function showPhoneCheckingOverlay() {
    phoneCheckingOverlay.classList.remove("hidden");
  }

  function hidePhoneCheckingOverlay() {
    phoneCheckingOverlay.classList.add("hidden");
  }

  function closeConfirmPhoneModal() {
    confirmPhoneOverlay.classList.add("hidden");
    if (confirmVerifyingTimer !== undefined) {
      window.clearTimeout(confirmVerifyingTimer);
      confirmVerifyingTimer = undefined;
    }
  }

  function openConfirmPhoneModal() {
    confirmationAttemptCount += 1;

    // Reset to the initial result phase every time the modal opens.
    confirmPhaseResult.classList.remove("hidden");
    confirmPhaseInput.classList.add("hidden");
    confirmPhaseLoading.classList.add("hidden");
    confirmPhaseSuccess.classList.add("hidden");
    confirmSuccessIconWrap.classList.remove("tick-pop");
    confirmPhoneInput.value = "";
    confirmPhoneError.classList.add("hidden");

    // Only the first attempt offers a shortcut back to editing information.
    confirmEditBtn.classList.toggle("hidden", confirmationAttemptCount > 1);

    confirmPhoneOverlay.classList.remove("hidden");
  }

  confirmEditBtn.addEventListener("click", () => {
    closeConfirmPhoneModal();
    confirmationInProgress = false;
    stopCheckingCountdown();
    goToFreeStep(1);
  });

  confirmOpenInputBtn.addEventListener("click", () => {
    confirmPhaseResult.classList.add("hidden");
    confirmPhaseInput.classList.remove("hidden");
    confirmPhoneInput.focus();
  });

  // Digits only, capped at 11 characters — matches the existing phone
  // validation rule used on the Information step.
  confirmPhoneInput.addEventListener("input", () => {
    const digitsOnly = confirmPhoneInput.value.replace(/\D/g, "").slice(0, 11);
    if (confirmPhoneInput.value !== digitsOnly) {
      confirmPhoneInput.value = digitsOnly;
    }
  });

  confirmSubmitBtn.addEventListener("click", () => {
    if (!registrationData) return;

    const entered = confirmPhoneInput.value.trim();
    if (entered.length === 0) {
      confirmPhoneError.textContent = "Please enter your phone number.";
      confirmPhoneError.classList.remove("hidden");
      return;
    }

    if (entered !== registrationData.phone) {
      confirmPhoneError.textContent = "Phone Number Does Not Match.";
      confirmPhoneError.classList.remove("hidden");
      return;
    }

    confirmPhoneError.classList.add("hidden");
    confirmPhaseInput.classList.add("hidden");
    confirmPhaseLoading.classList.remove("hidden");

    if (confirmVerifyingTimer !== undefined) {
      window.clearTimeout(confirmVerifyingTimer);
    }
    confirmVerifyingTimer = window.setTimeout(() => {
      confirmVerifyingTimer = undefined;
      confirmPhaseLoading.classList.add("hidden");
      confirmPhaseSuccess.classList.remove("hidden");

      // Replay the tick pop-in animation each time success is shown.
      confirmSuccessIconWrap.classList.remove("tick-pop");
      // Force reflow so the animation restarts reliably.
      void confirmSuccessIconWrap.offsetWidth;
      confirmSuccessIconWrap.classList.add("tick-pop");
    }, CONFIRM_VERIFYING_DELAY_MS);
  });

  confirmNextBtn.addEventListener("click", () => {
    closeConfirmPhoneModal();
    phoneConfirmed = true;
    confirmationInProgress = false;

    // Swap the error box for a light-green "Verified ✓" state now that the
    // phone number has been confirmed, and turn the button into
    // "Confirm Registration" with a nudging arrow to guide the user.
    setCheckingBoxState("verified");
    checkingStatusEl.textContent = "Verified ✓";
    sendBtnRestLabel = "Confirm Registration";
    sendBtnArrowVisible = true;
    setSendBtnEnabled(true);
    setSendingState(false);
  });

  // Sends the registration to the Google Apps Script Web App API as JSON.
  // The Apps Script is responsible for writing to the Google Sheet and
  // forwarding to Discord — this function never talks to Discord or
  // Telegram directly, and returns false (never throws) on any failure so
  // the caller can show the existing error UI.
  // Matches the backend's up-to-1-minute Discord retry loop (see Code.gs),
  // plus buffer for the Sheet write and network overhead — so the browser
  // doesn't abort and show a false "failed" error while the backend is
  // still legitimately retrying in the background.
  const FREE_REGISTRATION_TIMEOUT_MS = 70000;

  async function submitFreeRegistration(data: FreeRegistrationData): Promise<boolean> {
    const controller = new AbortController();
    const timeoutId = window.setTimeout(() => controller.abort(), FREE_REGISTRATION_TIMEOUT_MS);

    try {
      const response = await fetch(FREE_REGISTRATION_API_URL, {
        method: "POST",
        // NOTE: intentionally "text/plain", not "application/json".
        // Sending JSON with an application/json header triggers a CORS
        // preflight (OPTIONS) request, which Google Apps Script web apps
        // do not handle — the browser then blocks the whole request
        // before it ever reaches the script. text/plain counts as a
        // "simple request" so no preflight happens; Apps Script's
        // doPost(e) should parse the body with JSON.parse(e.postData.contents).
        headers: { "Content-Type": "text/plain;charset=utf-8" },
        body: JSON.stringify(data),
        signal: controller.signal,
      });

      if (!response.ok) {
        console.error("Free registration API returned an error status:", response.status);
        return false;
      }

      let result: any = null;
      try {
        result = await response.json();
      } catch (parseError) {
        console.error("Free registration API returned invalid JSON:", parseError);
        return false;
      }

      // Accept the common success shapes Apps Script web apps return.
      // Adjust this check to match your Apps Script's actual response if
      // it differs.
      const isExplicitFailure =
        result && (result.success === false || result.status === "error" || result.error);

      if (isExplicitFailure) {
        console.error("Free registration API reported failure:", result);
        return false;
      }

      // A 200 OK with a parseable JSON body and no explicit error/failure
      // field is treated as success. If your Apps Script always returns a
      // success flag (e.g. { success: true }), you can tighten this to
      // `return result?.success === true;` instead.
      return true;
    } catch (error) {
      if (error instanceof DOMException && error.name === "AbortError") {
        console.error("Free registration submission timed out.");
      } else {
        console.error("Free registration submission failed:", error);
      }
      return false;
    } finally {
      window.clearTimeout(timeoutId);
    }
  }

  sendNowBtn.addEventListener("click", async () => {
    if (sendNowBtn.disabled || !registrationData || confirmationInProgress) return;

    // Phone not yet confirmed for this registration: run the brief checking
    // state, then require the user to (re)confirm their phone number before
    // any submission happens. This is a frontend re-confirmation / anti-spam
    // step only — no submission logic runs here.
    if (!phoneConfirmed) {
      confirmationInProgress = true;
      clearSendError();
      setSendBtnEnabled(false);
      showPhoneCheckingOverlay();

      phoneCheckingTimer = window.setTimeout(() => {
        phoneCheckingTimer = undefined;
        hidePhoneCheckingOverlay();
        setSendBtnEnabled(true);
        openConfirmPhoneModal();
      }, PHONE_CHECKING_DELAY_MS);

      return;
    }

    // Phone already confirmed for this registration — proceed with the
    // actual submission to the Google Apps Script API.
    setSendingState(true);
    clearSendError();

    try {
      const succeeded = await submitFreeRegistration(registrationData);

      if (!succeeded) {
        showSendError("Submission failed. Please check your connection and try again.");
        setSendingState(false);
      } else {
        openSuccessPopup();
        setSendingState(false);
      }
    } catch (error) {
      console.error("Unexpected free registration submission error:", error);
      showSendError("Submission failed. Please check your connection and try again.");
      setSendingState(false);
    }
  });
</script>
