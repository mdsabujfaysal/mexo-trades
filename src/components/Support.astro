---
const channels = [
  {
    name: "Telegram",
    description: "Join our community and get quick updates.",
    href: "https://telegram.me/MexoGroup",
    iconBg: "bg-gradient-to-br from-sky-400 to-blue-600",
    glow: "bg-blue-400",
    link: "text-blue-700",
    icon: "M21.05 3.6 2.98 10.63c-1.23.49-1.22 1.17-.23 1.47l4.63 1.45 1.79 5.5c.22.6.37.84.75.84.35 0 .5-.16.7-.35l1.94-1.86 4.03 2.97c.75.41 1.28.2 1.47-.7l2.66-12.5c.28-1.1-.42-1.6-1.67-1.05Z",
  },
  {
    name: "WhatsApp",
    description: "Chat with our team directly.",
    href: "https://wa.me/message/24KMBYLOXRXUD1",
    iconBg: "bg-gradient-to-br from-emerald-400 to-teal-600",
    glow: "bg-emerald-400",
    link: "text-emerald-700",
    icon: "M17.5 14.4c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.24-.46-2.36-1.46-.87-.78-1.46-1.74-1.63-2.04-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.6-.92-2.2-.24-.57-.48-.5-.67-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.47 0 1.46 1.07 2.87 1.22 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.75-.71 2-1.4.25-.68.25-1.27.17-1.4-.07-.13-.27-.2-.57-.35Z M12 2C6.48 2 2 6.36 2 11.72c0 1.93.58 3.72 1.58 5.23L2 22l5.2-1.5a10.1 10.1 0 0 0 4.8 1.22c5.52 0 10-4.36 10-9.72S17.52 2 12 2Z",
  },
  {
    name: "Email",
    description: "Reach out for detailed inquiries.",
    href: "https://mail.google.com/mail/?view=cm&fs=1&to=mexotrades@gmail.com",
    // On mobile we try to open the native Gmail app directly instead of a
    // browser tab. gmailApp is the (undocumented but widely used) Gmail
    // app deep link; mailFallback is used if the Gmail app isn't installed.
    gmailApp: "googlegmail:///co?to=mexotrades@gmail.com",
    mailFallback: "mailto:mexotrades@gmail.com",
    iconBg: "bg-gradient-to-br from-violet-400 to-indigo-600",
    glow: "bg-indigo-400",
    link: "text-indigo-700",
    icon: "M2.25 6.75A2.25 2.25 0 0 1 4.5 4.5h15a2.25 2.25 0 0 1 2.25 2.25v10.5A2.25 2.25 0 0 1 19.5 19.5h-15a2.25 2.25 0 0 1-2.25-2.25V6.75Zm2.4-.75 7.35 5.51L19.35 6H4.65Zm14.85 1.64-7.03 5.27a1.5 1.5 0 0 1-1.8 0L3.75 7.64v9.61c0 .41.34.75.75.75h15a.75.75 0 0 0 .75-.75V7.64Z",
  },
];
---

<section id="support" class="relative bg-slate-50 py-20">
  <div id="support-animate" class="mx-auto max-w-6xl translate-y-10 px-6 opacity-0 transition-all duration-700 ease-out">
    <div class="text-center">
      <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
        We're Here to Help
      </h2>
      <p class="mt-4 text-lg text-slate-600">Reach us through your preferred channel.</p>
    </div>

    <div class="mt-14 grid gap-8 sm:grid-cols-3">
      {
        channels.map((channel) => (
          <a
            href={channel.href}
            target="_blank"
            rel="noopener noreferrer"
            data-channel={channel.name}
            data-gmail-app={channel.gmailApp}
            data-mail-fallback={channel.mailFallback}
            class="group relative flex flex-col items-center overflow-hidden rounded-3xl border border-slate-100 bg-white p-8 text-center shadow-[0_8px_30px_rgb(0,0,0,0.06)] transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700"
          >
            {/* soft blurred glow that blooms in on hover */}
            <span
              class={
                "pointer-events-none absolute -top-10 left-1/2 h-40 w-40 -translate-x-1/2 rounded-full opacity-0 blur-3xl transition-opacity duration-300 group-hover:opacity-30 " +
                channel.glow
              }
            />

            <span
              class={
                "relative flex h-16 w-16 items-center justify-center rounded-2xl shadow-lg transition-transform duration-300 group-hover:scale-110 " +
                channel.iconBg
              }
            >
              <svg
                class="h-8 w-8 text-white"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
                focusable="false"
              >
                <path d={channel.icon} />
              </svg>
            </span>

            <h3 class="relative mt-6 text-lg font-bold text-slate-900">{channel.name}</h3>
            <p class="relative mt-2 text-sm text-slate-600">{channel.description}</p>

            <span class={"relative mt-6 flex items-center gap-1.5 text-sm font-semibold " + channel.link}>
              Contact us
              <svg
                class="h-4 w-4 transition-transform group-hover:translate-x-1"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  fill-rule="evenodd"
                  d="M10.293 3.293a1 1 0 011.414 0l5 5a1 1 0 010 1.414l-5 5a1 1 0 01-1.414-1.414L13.586 10H4a1 1 0 110-2h9.586l-3.293-3.293a1 1 0 010-1.414z"
                  clip-rule="evenodd"
                />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Slide-up-and-fade-in animation the first time this section scrolls into view.
  const animatedEl = document.getElementById("support-animate");
  if (animatedEl) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animatedEl.classList.remove("translate-y-10", "opacity-0");
            animatedEl.classList.add("translate-y-0", "opacity-100");
          } else {
            animatedEl.classList.add("translate-y-10", "opacity-0");
            animatedEl.classList.remove("translate-y-0", "opacity-100");
          }
        });
      },
      { threshold: 0.2 }
    );
    observer.observe(animatedEl);
  }

  // On mobile devices, open the native Gmail app directly for the Email
  // channel instead of a mobile browser tab. Desktop keeps the normal
  // "open Gmail in a new tab" behavior untouched.
  const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
  const emailLink = document.querySelector('a[data-channel="Email"]');

  if (isMobile && emailLink instanceof HTMLAnchorElement) {
    const gmailAppUrl = emailLink.dataset.gmailApp;
    const mailFallbackUrl = emailLink.dataset.mailFallback;

    emailLink.addEventListener("click", (event) => {
      if (!gmailAppUrl) return;
      event.preventDefault();

      // Try to hand off to the installed Gmail app.
      window.location.href = gmailAppUrl;

      // If the app isn't installed, the browser stays on this page and
      // nothing happens — after a short wait, fall back to the device's
      // default mail handler instead of leaving the tap unanswered.
      setTimeout(() => {
        if (document.visibilityState === "visible" && mailFallbackUrl) {
          window.location.href = mailFallbackUrl;
        }
      }, 1200);
    });
  }
</script>
