---
// Premium, Trustpilot-inspired student reviews section for MEXO.
// Frontend-only demo: all data is static below. No backend, no submission
// form, no external review widget. Filtering/sorting run entirely client
// side against this local array.
//
// To add/edit a review, only this file needs to change — edit the
// `reviews` array.

interface Review {
  id: string;
  name: string;
  rating: 1 | 2 | 3 | 4 | 5;
  review: string;
  category: "trading" | "technical-analysis" | "risk-management";
  courseLabel: string;
  date: string; // display label, e.g. "August 2026"
  dateValue: string; // ISO date used for sorting
  location: string;
  verified: boolean;
}

