# -----------------------------------------------------------------------
# MEXO TRADES BACKEND — ENVIRONMENT VARIABLE TEMPLATE
# -----------------------------------------------------------------------
# Copy this file to ".env" and fill in real values there.
# Never commit the real ".env" file to version control.
# -----------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# Allowed origin(s) for CORS — set this to your frontend URL in production
# Example: https://mexotrades.com
FRONTEND_URL=http://localhost:4321

# -----------------------------------------------------------------------
# TELEGRAM BOT (to be implemented in a later step)
# Get TELEGRAM_BOT_TOKEN from @BotFather on Telegram.
# Get TELEGRAM_CHAT_ID from the chat/group/channel that should receive
# enrollment + payment proof notifications.
# -----------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------
# GMAIL NOTIFICATION (Nodemailer + Gmail SMTP)
# Use a Gmail App Password for EMAIL_PASS, not your normal Gmail password.
# -----------------------------------------------------------------------
EMAIL_USER=
EMAIL_PASS=
ADMIN_EMAIL=
